---
interface Props {
	title: string;
}
const { title } = Astro.props;

import '@fontsource/roboto';
import MesageError from "../components/Popups/Alerts/Error.astro";
import CreateParceller from '../components/Popups/CreateParceller.astro';
import Invite from '../components/Popups/Invite.astro';
import Header from '../components/Sections/Header.astro';
import Settings from '../components/Sections/Settings.astro';
import PreviewTemplate from '../components/Popups/PreviewTemplate.astro';

const logged = Astro.cookies.get("logged")?.value;
const id = Astro.cookies.get("ID-USER")?.value;

if(logged != 'true' && !id){
  return Astro.redirect("/SignIn")
}

let get_data: any;
let get_templates: any;
let templates: any;
let data: any;

try{
	get_data = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
	data = await get_data.json();
	data = data.message;

	if(data == "El Usuario no existe."){
		Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
		Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
		return Astro.redirect("/SignIn")
	}

	get_templates = await fetch(`http://localhost:4000/templates?id_user=${id}`);
	templates = await get_templates.json();
	templates = templates.message;

	if(templates == "No hay plantillas."){
		// Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
		// Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
		// return Astro.redirect("/SignIn")
	}

}catch(e){
	Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
    Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	return Astro.redirect("/SignIn")
}

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/Logo.jpg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@splidejs/splide@latest/dist/css/splide.min.css">
		<title>{title}</title>
	</head>
	<body>
		<Header header_text='Management Parcellers' color='bg-purple-500' username={data.users.username} email={data.users.email}></Header>
		<MesageError id="danger"></MesageError>
		<CreateParceller id_content='content-create-parcel'/>
		<Invite data={data}/>
		<Settings username='' email=''></Settings>
		<PreviewTemplate tittle="Asignatura de periodo" author="Luisk" description="loremasdasdasdasdasdasdasdsadas" location="template"></PreviewTemplate>
		<slot />
		<script src="../js/frontend/front.js"></script>


		<script src="../js/frontend/utilities/slide.js"></script>

		<!-- <script src="../js/canvas.js"></script> -->

	</body>
</html>
<style is:global>
	:root {

	}

	*{
		padding: 0;
		margin: 0;
		list-style: none;
		text-decoration: none;
	}

	html {
		font-family: 'Roboto', sans-serif;
		color-scheme: dark light;
		scroll-behavior: smooth;
	}

	body{
		min-width: 100vw;
		min-height: 100vh;
		overflow-x:hidden;
		background-color: #2b2929;
		touch-action: none;
	}

	input[type="number"]::-webkit-inner-spin-button,
	input[type="number"]::-webkit-outer-spin-button,
	input[type="number"]::-webkit-clear-button {
		-webkit-appearance: none;
		margin: 0;
	}
	
	input[type="search"]::-webkit-search-cancel-button {
		-webkit-appearance: none;
		display: none;
	}
	


	*::-webkit-scrollbar {
		width: 16px;
	}

	*::-webkit-scrollbar-track {
		background-color: transparent;
	}

	*::-webkit-scrollbar-thumb {
		background-color: #d6dee1;
	}
	*::-webkit-scrollbar-thumb {
		background-color: #d6dee1;
		border-radius: 20px;
	}
	*::-webkit-scrollbar-thumb {
		background-color: #d6dee1;
		border-radius: 20px;
		border: 6px solid transparent;
