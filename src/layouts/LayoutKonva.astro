---
interface Props {
	title: string;
}

const { title } = Astro.props;

import '@fontsource/roboto';
import MesageError from "../components/Popups/Alerts/Error.astro";
import Invite from '../components/Popups/Invite.astro';
import Export from '../components/Konva/Export.astro';

const logged = Astro.cookies.get("logged")?.value;
const id = Astro.cookies.get("ID-USER")?.value;

if(logged != 'true' && !id){
  return Astro.redirect("/SignIn")
}

let get_data: any;
let data: any;

try{
	get_data = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
	data = await get_data.json();
	data = data.message;

	// if(data == "El Usuario no existe."){
	// 	Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
	// 	Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	// 	return Astro.redirect("/SignIn")
	// }
}catch(e){
	// Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
    // Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	// return Astro.redirect("/SignIn")
}

---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/Logo.jpg" />
		<link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<MesageError id="danger"></MesageError>
		<Export></Export>
		<Invite data={data}/>
		<slot />
		<script src="../js/frontend/front.js"></script>
		<!-- <script src="../js/canvas.js"></script> -->
	</body>
</html>
<style is:global>
	:root {

	}

	*{
		padding: 0;
		margin: 0;
		list-style: none;
		text-decoration: none;
	}

	html {
		font-family: 'Roboto', sans-serif;
		color-scheme: dark light;
		scroll-behavior: smooth;
	}

	body{
		min-width: 100vw;
		min-height: 100vh;
		overflow:hidden;
		background-color: #2b2929;
		touch-action: none;
