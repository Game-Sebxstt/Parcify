---
---

<div id="options-parcel" class="w-full max-w-[15rem] h-fit hidden fixed z-50">
    <ul id="more-options-filter" class="bg-[#2b2929] p-1.5 shadow-lg shadow-[#181818] w-full flex flex-col justify-center item-start text-white animate-deployment">
      <li id="redirect" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default px-2 py-1 flex gap-2" data-filter="test">
        <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5"
        >
        <path d="M13 4h3a2 2 0 0 1 2 2v14" />
        <path d="M2 20h3" />
        <path d="M13 20h9" />
        <path d="M10 12v.01" />
        <path d="M13 4.562v16.157a1 1 0 0 1-1.242.97L5 20V5.562a2 2 0 0 1 1.515-1.94l4-1A2 2 0 0 1 13 4.561Z" />
      </svg>

        <span>
          Abrir
        </span>
      </li>

      <li id="redirect-external" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default px-2 py-1 flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-external-link h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 6h-6a2 2 0 0 0 -2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-6" />
          <path d="M11 13l9 -9" />
          <path d="M15 4h5v5" />
        </svg>

        <span>
          Abrir en otra pestaña
        </span>
      </li>

      <span class="separator-options w-full h-[1px] bg-[#383838] my-2"></span>

      <li id="duplicate-parcel" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default px-2 py-1 flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-copy h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" />
          <path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" />
        </svg>

        <span>
          Duplicar
        </span>
      </li>

      <li id="delete-parcel" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default px-2 py-1 flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-trash h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M4 7l16 0" />
          <path d="M10 11l0 6" />
          <path d="M14 11l0 6" />
          <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
          <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
        </svg>

        <span>
          Eliminar
        </span>
      </li>

      <li id="rename-parcel" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default px-2 py-1 flex gap-2" data-filter="test">
        <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="white"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5"
      >
        <path d="M17 3a2.85 2.83 0 1 1 4 4L7.5 20.5 2 22l1.5-5.5Z" />
        <path d="m15 5 4 4" />
      </svg>

        <span>
          Cambiar nombre
        </span>
      </li>

      <span class="separator-options w-full h-[1px] bg-[#383838] my-2"></span>

      <li id="favorite" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default flex px-2 py-1 gap-2" data-filter="test">
          <svg class="icon icon-tabler icons-tabler-outline icon-tabler-star" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" />
          </svg>
          <span>Añadir a favoritos</span>
      </li>

      <li id="unfavorite" class="hover:bg-[#1E90FF] w-full transition-all duration-150 ease-in cursor-default hidden px-2 py-1 gap-2" data-filter="test">
        <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-star-off">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M3 3l18 18" />
          <path d="M10.012 6.016l1.981 -4.014l3.086 6.253l6.9 1l-4.421 4.304m.012 4.01l.588 3.426l-6.158 -3.245l-6.172 3.245l1.179 -6.873l-5 -4.867l6.327 -.917" />
          </svg>
          <span>Quitar de Favoritos</span>
      </li>
    </ul>
  </div>