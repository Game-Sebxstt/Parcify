---
interface Props {
    section?:string,
    article?:string,
    isSpecificTemplate?: boolean,
}

const {section, article } = Astro.props;
---

<div class="flex items-center justify-between w-full pr-2">
    <div class="relative w-fit flex flex-col gap-1">
        <div id="filter" class="flex items-end gap-2 cursor-pointer">
            <div class="w-fit h-fit flex items-center gap-2">
                <span class="text-gray-300 font-semibold text-xl max-[880px]:text-base w-fit h-fit">
                    Filter:
                </span>
                <span id="typeFilter" class="text-white font-bold text-lg max-[880px]:text-base cursor-pointer w-fit h-fit">
                    Todos los Proyectos
                </span>
            </div>

            <svg id="arrow-down-filter" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down h-6 cursor-pointer transition-all duration-200 ease-in">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M6 9l6 6l6 -6"/>
            </svg>
        </div>
        
        <ul id="more-options-filter" data-section={section} data-article={article} class="absolute z-[15] mt-10 bg-[#2b2929] p-1.5 shadow-lg shadow-[#181818] hidden flex-col gap-2 text-white animate-deployment">
            <li id="filtro" class="hover:bg-[#1E90FF] w-[15rem] h-[2.5rem] flex items-center justify-between transition-all duration-150 ease-in cursor-pointer px-2 py-1" data-filter="Nombre (A-Z)">
                <p>Nombre (A - Z)</p>
                <div id="orden" class="flex items-center p-2"></div>
            </li>

            <li id="filtro" class="hover:bg-[#1E90FF] w-[15rem] h-[2.5rem] flex items-center justify-between transition-all duration-150 ease-in cursor-pointer px-2 py-1" data-filter="Ultima Modificacion">
                <p>Ultima Modificacion</p>
                <div id="orden" class="flex items-center p-2"></div>
            </li>

            <li id="filtro" class="hover:bg-[#1E90FF] w-[15rem] h-[2.5rem] flex items-center justify-between transition-all duration-150 ease-in cursor-pointer px-2 py-1" data-filter="Compartidos">
                <p>Compartidos Conmigo</p>
            </li>

            <li id="filtro" class="hover:bg-[#1E90FF] w-[15rem] h-[2.5rem] flex items-center justify-between transition-all duration-150 ease-in cursor-pointer px-2 py-1" data-filter="Todos los proyectos">
                <p>Todos los Proyectos</p>
            </li>
        </ul>
    </div>

    <div class="flex items-center justify-center">
        <!-- <svg id="order-chart" class="h-5 cursor-pointer scale-125 transition-all duration-200 ease-in" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 12 12">
            <path fill="white" fill-opacity="1" fill-rule="evenodd" stroke="none" d="M1 1h3v3H1V1zM0 0h5v5H0V0zm1 8h3v3H1V8zM0 7h5v5H0V7zm11-6H8v3h3V1zM8 0H7v5h5V0H8zm0 8h3v3H8V8zM7 7h5v5H7V7z"></path>
        </svg> -->
    </div>
</div>

<script >
    //texto a cambiar
    let typeFilter = document.querySelector('#typeFilter') as HTMLSpanElement;

    //los filtros
    let filtros = document.querySelectorAll<HTMLLIElement>("#filtro");

    //contenetor
    let orden = document.querySelectorAll<HTMLDivElement>("#orden");

    
    const ascendente = `<svg id="arrowUp"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#ffffff"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M18 11l-6 -6" /><path d="M6 11l6 -6" /></svg>`
    const descente = `<svg id="arrowDown"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#ffffff"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-down h-5"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 5l0 14" /><path d="M18 13l-6 6" /><path d="M6 13l6 6" /></svg>`
    
    orden.forEach((item) => {
        item.innerHTML = ascendente;
        item.classList.add('ascendente');

        // Añadir el evento click a cada contenedor orden
        item.addEventListener("click", () => {
            if (item.classList.contains('ascendente')) {
                item.innerHTML = descente;
                item.classList.remove('ascendente');
                item.classList.add('descendente');
            } else if (item.classList.contains('descendente')) {
                item.innerHTML = ascendente;
                item.classList.remove('descendente');
                item.classList.add('ascendente');
            }
        });
    });

    //evento
    filtros.forEach((item)=>{
        item?.addEventListener("click",()=>{
            //cambiar el texto de que tiene dentro typefilter por el texto
            //que tiene el filtro seleccionado
            typeFilter.textContent = item.textContent;
            // Subrayar el filtro seleccionado
            filtros.forEach(filtro => filtro.style.textDecoration = "none"); // Quitar subrayado de todos
            item.style.textDecoration = "underline"; // Subrayar el seleccionado

            //FILTRO logica
            //data-name = "nombre"
            //quiero un filtro (no una barra de busqueda, mas bien un <select>) que me permita ordenar 10 divs en orden alfabetico descendete y de forma ascendente
            
        })
    });

    
</script>
