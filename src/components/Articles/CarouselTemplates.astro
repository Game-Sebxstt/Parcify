---
import { getAllTemplates } from "../../js/backend/requests";

const reqTemplates = await getAllTemplates();
let templates;

if (!reqTemplates.state) {
  templates = [
    {
      name: "Plantilla Vacia",
      template_id: 0,
      preview: "../../../public/placeholder/image_preview.svg",
      description: "Plantilla Vacia.",
      autor: "Parcify",
      likes: null,
    },
  ];
} else {
  templates = reqTemplates.data.message.slice(0, 5);

  if (!(templates.length >= 5)) {
    templates.push({
      name: "Plantilla Vacia",
      template_id: 0,
      preview: "../../../public/placeholder/image_preview.svg",
      description: "Plantilla Vacia.",
      autor: "Parcify",
      likes: null,
    });
  }
}
---

<div class="w-full max-w-3xl h-full">
  <div id="splide" class="splide w-full h-full">
    <div class="splide__track w-full h-full">
      <ul class="splide__list w-full h-full">
        {
          templates.length > 0 ? (
            templates.map((template: any) => (
              <li
                class="splide__slide w-full h-full"
                data-splide-interval="3000"
              >
                <div class="w-full h-full bg-[#1E1E1E] flex justify-center items-center text-[24px] text-black cursor-pointer">
                  <img src={template.preview} class="w-full h-full" />
                  <div
                    id="create-template"
                    data-id={template.template_id}
                    data-name={template.name}
                    data-preview={template.preview}
                    data-author={template.autor}
                    data-description={template.description}
                    class="background-animation w-full h-full absolute hover:bg-[#1E1E1E]/60 transition-all ease duration-300"
                  />
                  <span class="absolute bottom-8 left-5 text-white ">
                    {template.name}
                  </span>
                </div>
              </li>
            ))
          ) : (
            <p>No templates available</p>
          )
        }
      </ul>
    </div>

    <div class="my-carousel-progress">
      <div
        class="my-carousel-progress-bar bg-[#1E90FF] h-0.5 transition-all duration-[400] w-0"
      >
      </div>
    </div>
  </div>
</div>
