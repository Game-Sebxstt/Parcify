---
interface Props{
  first_text: string;
  second_text: string;
  url_image: string,
  template_id: string,
}

const { first_text, second_text, url_image, template_id } = Astro.props;
---

<div data-id={template_id} id="create-template" class="w-full h-fit cursor-pointer">
    <div class="w-full h-72 relative mb-2">
      <div class="bg-[#E6E6E6] w-full h-full rounded-md shadow-md shadow-black mb-2 absolute top-0 left-0">
        {
          url_image ? (
            <img src={url_image} class="w-full h-full rounded-md">
          ) : (
            <img src="../../../public/placeholder/image_preview.svg" class="w-full h-full rounded-md">
          )
        }
      </div>

      <div class="w-full h-full flex justify-center items-center rounded-md shadow-md shadow-black mb-2 border-2 border-transparent cursor-pointer transition-all duration-[500] ease-in hover:border-[#FB7F53] hover:bg-[#FB7F5E]/70 [&>svg]:hover:opacity-100 absolute top-0 left-0">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-plus w-12 opacity-0 transition-all duration-[500] ease-in" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 5l0 14" />
          <path d="M5 12l14 0" />
        </svg>
      </div>
    </div>
  
    <div class="flex justify-start gap-5 items-center">  
      <div>
        <img src="../../../Logo-no-background-no-text.png" class="h-12 max-xl:h-10">
      </div>

      <div class="flex flex-col">
        <h3 class="text-white text-xl font-bold max-xl:text-lg">{first_text}</h3>
        <h4 class="text-gray-300 text-lg max-xl:text-base">{second_text}</h4>
      </div>
    </div>
</div>