---
interface Props{
    text: string;
}

const { text } = Astro.props;
---

<div class="w-full h-full bg-[#505050] flex flex-col justify-center items-center gap-2 py-2 rounded-md cursor-pointer hover:bg-[#505050]/50">
    <slot/>
    <h4 class="text-white text-sm text-wrap">
        {text}
    </h4>
</div>