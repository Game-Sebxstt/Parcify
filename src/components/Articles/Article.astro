---

interface Props{
  id:string,
  name: string,
  last_modified: string,
  project_id: string,
  preview: string,
  stage: string,
  collaborators: string,
}

export function lastModified(fechas: any) {
    const fechasObjeto = fechas.map((fecha: any) => new Date(fecha));
    const ultimaModificacion: any = new Date(Math.max(...fechasObjeto));
    const ahora: any = new Date();

    const diferencia = ahora - ultimaModificacion;

    const segundos = Math.floor(diferencia / 1000);
    const minutos = Math.floor(segundos / 60);
    const horas = Math.floor(minutos / 60);
    const dias = Math.floor(horas / 24);
    const meses = Math.floor(dias / 30);
    const años = Math.floor(meses / 12);

    if (años > 0) {
        return `${años} año${años !== 1 ? 's' : ''}`;
    } else if (meses > 0) {
        return `${meses} mes${meses !== 1 ? 'es' : ''}`;
    } else if (dias > 0) {
        return `${dias} día${dias !== 1 ? 's' : ''}`;
    } else if (horas > 0) {
        return `${horas} hora${horas !== 1 ? 's' : ''}`;
    } else if (minutos > 0) {
        return `${minutos} minuto${minutos !== 1 ? 's' : ''}`;
    } else {
        return `${segundos} segundo${segundos !== 1 ? 's' : ''}`;
    }
}


async function isFavorite(project_id:number) {
  const id = Astro.cookies.get("ID-USER")?.value;

  // datos de los favoritos
  let getDataPreferences:any = await fetch(`http://localhost:4000/preferences/data?id_user=${id}`);
  let dataPreferences = await getDataPreferences.json();

  // data del usuario
  let getDataUser:any = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
  let dataUser = await getDataUser.json();

  let dataFilter:any = [];
  const isData = getDataPreferences.ok ? true : false;

  if (isData){
      const elementParsed = JSON.parse(dataPreferences.message[0].favorites)
      const projectUser = dataUser.message.projects;

      elementParsed.forEach((item:any) => { // 2 -> [0] - [1] -> elementParsed
          projectUser.forEach((elementUser:any) => { // 2 -> [0] - [1] -> projectUser
              if (elementUser.project_id === item.id) { // elementParsed[0].id === projectUser[0].project_id
                  elementUser["type"] = item.type; // project_id, user_id, name, preview, stage, collaborators, last_modified -> elementParsed[0] || [1]
                  dataFilter.push(elementUser); // dataFilter = [elementParsed[0] || [1]]
              }
          });
      });
  }

  return dataFilter.some((favorite:any) => favorite.project_id === project_id);
}

//Data variables
const {id, name, last_modified, project_id, preview, stage, collaborators} = Astro.props;
---

<div id={id} class="w-full h-fit relative" data-name={name} data-modified={last_modified}>
  <div id="options-parcel" class="w-fit h-fit hidden fixed z-50">
    <ul id="more-options-filter" class="bg-[#2b2929] rounded-md shadow-lg shadow-[#181818] w-fit flex flex-col justify-center item-start text-white animate-deployment">
      <li id="duplicate-parcel" data-id={project_id} class="hover:bg-[#1E90FF] transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-t-md flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-copy h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" />
          <path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" />
        </svg>

        <span>
          Duplicar
        </span>
      </li>
      <li id="delete-parcel" data-id={project_id} class="hover:bg-[#1E90FF] transition-all duration-150 ease-in cursor-pointer px-2 py-1 flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-trash h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M4 7l16 0" />
          <path d="M10 11l0 6" />
          <path d="M14 11l0 6" />
          <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
          <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
        </svg>

        <span>
          Eliminar
        </span>
      </li>
      <li id="favorite" data-id={project_id} class="hover:bg-[#1E90FF] transition-all duration-150 ease-in cursor-pointer px-2 py-1 flex gap-2" data-filter="test">
        {await isFavorite(Number(project_id)) ? (
          <article id="quitFavorite" class="flex items-center gap-1">
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-star-off">
              <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
              <path d="M3 3l18 18" />
              <path d="M10.012 6.016l1.981 -4.014l3.086 6.253l6.9 1l-4.421 4.304m.012 4.01l.588 3.426l-6.158 -3.245l-6.172 3.245l1.179 -6.873l-5 -4.867l6.327 -.917" />
            </svg>          
            <span>Quitar de Favoritos</span>
          </article>
        ) : (
            <article id="addFavorite"  class="flex items-center gap-1">
              <svg class="icon icon-tabler icons-tabler-outline icon-tabler-star" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 17.75l-6.172 3.245l1.179 -6.873l-5 -4.867l6.9 -1l3.086 -6.253l3.086 6.253l6.9 1l-5 4.867l1.179 6.873z" />
              </svg>
              <span>Añadir a favoritos</span>
            </article>
        )}
      </li>
      <li id="rename-parcel" data-id={project_id} class="hover:bg-[#1E90FF] transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-b-md flex gap-2" data-filter="test">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-edit" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1" />
          <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z" />
          <path d="M16 5l3 3" />
        </svg>  
        <span>
          Cambiar nombre
        </span>
      </li>
    </ul>
  </div>

  <div id="element-project" data-id={project_id} class="bg-transparent border-2 border-transparent hover:border-[#1E90FF]/70 hover:bg-[#1E90FF]/30 rounded-md shadow-md shadow-black mb-2 absolute cursor-pointer w-full h-72 z-10"></div>

  <div class="bg-[#f5f5f5] rounded-md shadow-md shadow-black mb-2 relative cursor-pointer w-full h-72">
    {
      preview ? (
        <img src={preview} class="w-full h-full"/>
      ) : (
        <img src="../../../public/placeholder/image_preview.svg" class="w-full h-full"/>
      )
    }
  </div>

  <div class="flex justify-between w-full items-center">
    <div class="flex flex-col w-full">
      <h3 id ="name-of-parcel" class="text-white text-xl font-bold max-xl:text-lg truncate w-full">{name}</h3>
      <input id="input-of-parcel" type="text" value={name} class="bg-transparent hidden text-white text-xl font-bold max-xl:text-lg truncate w-full">
      <h4 class="text-gray-300 text-lg max-xl:text-base">Editado hace {lastModified([last_modified])}</h4>
    </div>
  </div>
</div>
