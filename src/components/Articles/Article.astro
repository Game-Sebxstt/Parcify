---
interface Props{
  first_text: string;
  second_text: string;
}

const { first_text, second_text } = Astro.props;
---

<div>
  <div class="bg-[#E6E6E6] w-full h-72 rounded-md shadow-md shadow-black mb-2 relative">
    <svg id="btn-options-parcel" class="icon icon-tabler icons-tabler-outline icon-tabler-dots w-8 absolute right-2 cursor-pointer" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="black"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M5 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M12 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
      <path d="M19 12m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0"/>
    </svg>

    <div id="options-parcel" class="w-full h-fit hidden relative">
      <ul id="more-options-filter" class="absolute right-1 mt-7 bg-[#2b2929] rounded-md shadow-lg shadow-[#181818] w-fit flex flex-col justify-center item-start text-white animate-deployment">
        <li class="hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-t-md flex gap-2" data-filter="test">
          <svg class="icon icon-tabler icons-tabler-outline icon-tabler-copy h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M7 7m0 2.667a2.667 2.667 0 0 1 2.667 -2.667h8.666a2.667 2.667 0 0 1 2.667 2.667v8.666a2.667 2.667 0 0 1 -2.667 2.667h-8.666a2.667 2.667 0 0 1 -2.667 -2.667z" />
            <path d="M4.012 16.737a2.005 2.005 0 0 1 -1.012 -1.737v-10c0 -1.1 .9 -2 2 -2h10c.75 0 1.158 .385 1.5 1" />
          </svg>

          <span>
            Duplicar
          </span>
        </li>
        
        <li class="hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-b-md flex gap-2" data-filter="test">
          <svg class="icon icon-tabler icons-tabler-outline icon-tabler-trash h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M4 7l16 0" />
            <path d="M10 11l0 6" />
            <path d="M14 11l0 6" />
            <path d="M5 7l1 12a2 2 0 0 0 2 2h8a2 2 0 0 0 2 -2l1 -12" />
            <path d="M9 7v-3a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v3" />
          </svg>

          <span>
            Eliminar
          </span>
        </li>
      </ul>
    </div>
  </div>

  <div class="flex justify-between items-center">
    <div class="flex flex-col">
      <h3 class="text-white text-xl font-bold max-xl:text-lg">{first_text}</h3>
      <h4 class="text-gray-300 text-lg max-xl:text-base">{second_text}</h4>
    </div>

    <div>
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle h-8 max-xl:h-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
          <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0"></path>
          <path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0"></path>
          <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855"></path>
        </svg>
    </div>
  </div>
</div>


<script>
  let options_parcel = document.querySelectorAll("#btn-options-parcel") as NodeListOf<HTMLElement>;

  options_parcel?.forEach(item => {
    item.addEventListener("click", function() {
      (item.parentNode?.querySelector("#options-parcel") as HTMLDivElement).style.display = window.getComputedStyle(item.parentNode?.querySelector("#options-parcel") as HTMLElement).display == "none" ? "flex" : "none";
    });
  })
</script>