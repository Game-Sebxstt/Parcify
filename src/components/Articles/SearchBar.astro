---
interface Props {
    placeholder:string,
    section:string,
    article:string,
}

const {placeholder, section, article} = Astro.props;
---

<ul class="grid_filter flex gap-2 max-md:text-sm pr-2 place-items-center">
    <li class="relative w-full h-fit py-1 px-2 cursor-pointer flex justify-center items-center text-center">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-search h-6 absolute left-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"> <path stroke="none" d="M0 0h24v24H0z" fill="none"></path> <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0"></path> <path d="M21 21l-6 -6"></path></svg>
        <input 
            type="search" 
            id="searchbar"
            data-section={section} 
            data-article={article}
            placeholder={placeholder}
            class="pl-11 pr-3 bg-[#292929] border-2 border-[#3e3e3e] rounded-lg text-white px-6 py-3 text-base hover:border-[#1E90FF] outline-none cursor-pointer transition max-[880px]:w-full"/>
    </li>
</ul>

