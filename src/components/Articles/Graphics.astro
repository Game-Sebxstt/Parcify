---
interface Props{
    name:string,
    description: string,
    likes:string,
}


const { name, description, likes } = Astro.props;
---

<div class=`cursor-pointer` data-name={name}>
    <div class="w-full rounded-md shadow-md mb-2 h-72">
        <canvas id="myChart" class="w-full h-full rounded-md shadow-md shadow-black mb-2"></canvas>
    </div>

    <div class="flex justify-between gap-5 items-center">
        <div class="flex flex-col">
            <h3 id="tittleTemplate" class="text-white text-xl font-bold max-xl:text-lg">{name}</h3>
            <h4 id="authorTemplate" class="text-gray-300 text-lg max-xl:text-base">{description}</h4>
        </div>

        <div class="flex items-center gap-1 justify-between">
            <h3 class="text-white text-sm font-bold max-xl:text-sm">{likes}</h3>
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="#ffffff" ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z" /></svg>
        </div>
    </div>
</div>

