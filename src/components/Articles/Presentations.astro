---
interface Props{
    title: string;
    owner: string;
    created: string;
    lastModified: string;
    description: string;
}

const {  title, owner, created, lastModified, description } = Astro.props;
---

<div id="contenedor" class="container animate-deployment"> 
    <header>
        <img src="../../../..Logo-no-background-no-text.png" alt="Logo Parcify" />
        <h2>{title}</h2>
    </header>

    <p><strong>Propietario:</strong> {owner}</p>
  
    <p><strong>Creado:</strong> {created}</p>
  
    <p><strong>Última Modificación:</strong> {lastModified}</p>

    <p><strong>Descripción:</strong></p>

    <textarea class="description" readonly>{description}</textarea>
 
    <div class="buttons">
        <button class="button delete">Delete</button>
        <button class="button duplicate">Duplicate</button>
    </div>
</div>

<style>
  *{
      padding: 0;
      margin: 0;
      gap: 10px;
      
  }
  header{
      display: flex;
      justify-content: space-between;
  }
.container {
  width: 400px;
  height: 400px;
  background-color: #333;
  border: 1px solid #444;
  border-radius: 8px;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
  padding: 20px;
  box-sizing: border-box;
  display: none;
  flex-direction: column;
  color: #fff;
  font-family: Arial, sans-serif;
  z-index: 99;
  position: absolute;
  top: 15px;
  left:0px;
}
.container header {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}
.container header img {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  margin-right: 10px;
}
.container header h2 {
  flex-grow: 1;
  font-size: 18px;
  text-align: center;
  margin: 0;
}
.container header::after {
  content: '';
  flex-grow: 1;
  border-bottom: 1px solid #e74c3c;
  margin-left: 10px;
}
.container body p {
  margin: 10px 0;
}
.container body p strong {
  display: inline-block;
  width: 150px;
}
.description {
  background-color: #c6c6c6;
  border: none;
  border-radius: 4px;
  color: #fff;
  padding: 43px;
  margin: 20px 0;
  resize: none;
  
}
.buttons {
  display: flex;
  justify-content: space-between;
}
.container button {
  padding: 10px 20px;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
}
.delete {
  background-color: #e74c3c;
  color: #fff;
}
.duplicate {
  background-color: #3498db;
  color: #fff;
}
img{
  height: 50px;
  width: 50px;
  border-radius: 50%;
  margin-right: 60px;
}


</style>

<script>
const boton = document.querySelector("#details-project")
const container = document.querySelector("#contenedor") as HTMLElement

boton?.addEventListener("click", function() {
  container.style.display = window.getComputedStyle(container).display == "none" ? "flex" : "none";
});
</script>
