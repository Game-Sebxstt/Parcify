---
interface Props{
    description: string,
    title: string,
    autor: string,
    downloads: number,
    weights: number,
    likes: number,
}

function formatLargeNumber(num: number) {
    if (num >= 10000 && num < 1000000) {
        return (num / 1000).toFixed(1) + 'k';
    } else if (num >= 1000000) {
        return (num / 1000000).toFixed(1) + 'M';
    } else {
        return num.toString();
    }
}

const { description, title, autor, downloads, weights, likes } = Astro.props;
let download = formatLargeNumber(downloads);
let weight = formatLargeNumber(weights);
let like = formatLargeNumber(likes);

---

<div class="w-full h-full bg-[#505050] flex flex-col justify-center items-center gap-2 py-2 rounded-md cursor-pointer hover:bg-[#505050]/50 relative">
    <div class="flex flex-col gap-2 px-2">
        <div class="flex justify-start w-full h-fit gap-2">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-cube h-10" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718z" />
                <path d="M12 22v-10" />
                <path d="M12 12l8.73 -5.04" />
                <path d="M3.27 6.96l8.73 5.04" />
            </svg>

            <div class="flex justify-start gap-2 h-full items-center">
                <span class="font-bold text-lg h-full flex items-center">
                    {title}
                </span>
            </div>
        </div>

        <div>
            <p>
                {description}
            </p>
        </div>
    </div>

    <div class="w-full h-fit border-t-2 border-white pt-2 flex justify-around">
        <span class="flex gap-1 text-sm items-center">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-world h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M3 12a9 9 0 1 0 18 0a9 9 0 0 0 -18 0" />
                <path d="M3.6 9h16.8" />
                <path d="M3.6 15h16.8" />
                <path d="M11.5 3a17 17 0 0 0 0 18" />
                <path d="M12.5 3a17 17 0 0 1 0 18" />
            </svg>

            {download}
        </span>

        <span class="flex gap-1 text-sm items-center">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-database h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="currentColor"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 6m-8 0a8 3 0 1 0 16 0a8 3 0 1 0 -16 0" />
                <path d="M4 6v6a8 3 0 0 0 16 0v-6" />
                <path d="M4 12v6a8 3 0 0 0 16 0v-6" />
            </svg>

            {weight}
        </span>

        <span class="flex gap-1 text-sm items-center">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-heart h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M19.5 12.572l-7.5 7.428l-7.5 -7.428a5 5 0 1 1 7.5 -6.566a5 5 0 1 1 7.5 6.572" />
            </svg>

            {likes}
        </span>
    </div>

    <span class="p-1 bg-gray-500 rounded-[3px] hover:bg-gray-500/70 absolute right-2 top-2 w-fit h-fit">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-download h-6 w-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
            <path d="M7 11l5 5l5 -5" />
            <path d="M12 4l0 12" />
        </svg>
    </span>
</div>