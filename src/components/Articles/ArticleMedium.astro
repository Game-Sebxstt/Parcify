---
// Importar Template y templateData
import Template from "../Articles/Template.astro";
import { templateData } from "../../js/frontend/Templates";
import PreviewTemplate from "../Popups/PreviewTemplate.astro";
interface Props {
    first_text: string;
}

const { first_text } = Astro.props;
const hasTemplates = Array.isArray(templateData) && templateData.length > 0;
---

<div class="carousel-container flex justify-center items-center w-[90%] h-full mx-auto">
  <button class="arrow-button bg-slate-700/70 shadow-md hover:bg-slate-800/70 shadow-black rounded-lg flex justify-center items-center w-fit h-fit arrow-left text-white border-none text-[50px] cursor-pointer z-[2] translate-x-1/2" id="left_arrow">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left w-12 h-12">
      <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
      <path d="M15 6l-6 6l6 6" />
    </svg>
  </button>

  <div class="carousel flex overflow-hidden justify-center items-center w-full">
    <div class="carousel-inner flex transition-transform ease-in-out duration-500 w-full" id="carousel-inner">
      {hasTemplates ? (
        templateData.map((template) => (
            <Template
              clase="carousel-item w-full h-auto flex-shrink-0"
              typeElement={template.typeElement}
              name={template.name}
              description={template.description}
              likes={template.likes}
          />
        ))
      ) : (
        <div class="text-center text-gray-500">No templates available</div>
      )}
    </div>
  </div>

  <button class="arrow-button bg-slate-700/70 shadow-md hover:bg-slate-800/70 shadow-black rounded-lg arrow-right text-white border-none text-[50px] cursor-pointer z-[2] -translate-x-1/2" id="right_arrow">
    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="#ffffff"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right w-12 h-12"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M9 6l6 6l-6 6" /></svg>
  </button>
</div>

<style>
  .carousel-inner {
  display: flex;
  transition: transform 0.5s ease-in-out;
  width: 100%;
}

.carousel-item {
  min-width: 100%; /* Ocupa todo el ancho del carrusel */
  height: auto;
  flex-shrink: 0;
}

</style>
<script>
  // Carousel start
  const carouselInner = document.querySelector("#carousel-inner") as HTMLDivElement;
  const items = document.querySelectorAll<HTMLElement>(".carousel-item");
  const totalItems = items.length;

  let currentIndex = 0;
  const itemWidth = items[0].offsetWidth + 20; // Ajusta al margen derecho

  function slide(direction:any) {
    if (direction === -1 && currentIndex === 0) {
      currentIndex = totalItems - 1;
    } else if (direction === 1 && currentIndex === totalItems - 1) {
      currentIndex = 0;
    } else {
      currentIndex += direction;
    }

    carouselInner.style.transform = `translateX(${-currentIndex * itemWidth}px)`;
  }

  const left_arrow = document.getElementById("left_arrow");
  const right_arrow = document.getElementById("right_arrow");

  left_arrow?.addEventListener("click", () => slide(-1));
  right_arrow?.addEventListener("click", () => slide(1));

  // Carousel end
</script>