---
interface Props{
    first_text: string;
}

const {first_text} = Astro.props;
---

<div class="carousel-container absolute flex justify-center items-center w-[90%] mx-auto">
    <button class="arrow-button bg-slate-700/70 shadow-md hover:bg-slate-800/70 shadow-black rounded-lg flex justify-center items-center w-fit h-fit arrow-left text-white border-none text-[50px] cursor-pointer z-[2] translate-x-1/2" id="left_arrow">
      <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left w-12 h-12">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M15 6l-6 6l6 6" />
      </svg>
    </button>

    <div class="carousel flex overflow-hidden justify-center items-center h-full w-full">
      <div class="carousel-inner flex transition-transform ease-in-out duration-500" id="carousel-inner">
        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[1] opacity-100 shadow-[rgb(216,212,212)_-17px_-7px] text-black">
          {first_text}
        </div>

        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[0.8] opacity-50 text-black">
          {first_text}
        </div>

        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[0.8] opacity-50 text-black">
          {first_text}
        </div>
      </div>
    </div>

    <button class="arrow-button bg-slate-700/70 shadow-md hover:bg-slate-800/70 shadow-black rounded-lg arrow-right text-white border-none text-[50px] cursor-pointer z-[2] -translate-x-1/2" id="right_arrow">
      <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right w-12 h-12">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M9 6l6 6l-6 6" />
      </svg>
    </button>
</div>

<script>
  // Carousel start
  
  const carouselInner = document.querySelector("#carousel-inner");
  console.log(carouselInner)
  let currentIndex = 1; // Start with the first real item
  const items = document.querySelectorAll(".carousel-item");
  const totalItems = items.length;
  
  // Loop effect: clone first and last few items
  const carouselChildren = [...carouselInner.children];
  const elementos = document.querySelector(".carousel-item").offsetWidth;
  let cardPerView = Math.round(carouselInner.offsetWidth / elementos);
  
  // Cloning the items
  carouselChildren
    .slice(-cardPerView)
    .reverse()
    .forEach((card) => {
      carouselInner.insertAdjacentHTML("afterbegin", card.outerHTML);
    });
  
  carouselChildren.slice(0, cardPerView).forEach((card) => {
    carouselInner.insertAdjacentHTML("beforeend", card.outerHTML);
  });
  
  const allItems = document.querySelectorAll(".carousel-item");
  const realItemsCount = totalItems; // Number of real items without clones
  const totalCarouselItems = allItems.length; // Total items including clones
  
  // Update the currentIndex to the first real item
  currentIndex = cardPerView;
  
  function slide(direction) {
    const items = document.querySelectorAll(".carousel-item");
    const totalItems = items.length;
  
    // Calculate the new index
    currentIndex = (currentIndex + direction + totalItems) % totalItems;
  
    // Handle infinite loop: reset position when reaching the clone items
    if (currentIndex < cardPerView) {
      setTimeout(() => {
        carouselInner.style.transition = "none";
        currentIndex = realItemsCount + currentIndex;
        updateFocus();
        const resetOffset =
          -currentIndex * (items[0].offsetWidth + 20) +
          (carouselInner.offsetWidth - items[0].offsetWidth) / 2;
        carouselInner.style.transform = `translateX(${resetOffset}px)`;
        setTimeout(() => {
          carouselInner.style.transition = "transform 0.5s ease-in-out";
        }, 50);
      }, 500);
    } else if (currentIndex >= realItemsCount + cardPerView) {
      setTimeout(() => {
        carouselInner.style.transition = "none";
        currentIndex = currentIndex - realItemsCount;
        updateFocus();
        const resetOffset =
          -currentIndex * (items[0].offsetWidth + 20) +
          (carouselInner.offsetWidth - items[0].offsetWidth) / 2;
        carouselInner.style.transform = `translateX(${resetOffset}px)`;
        setTimeout(() => {
          carouselInner.style.transition = "transform 0.5s ease-in-out";
        }, 50);
      }, 500);
    }
  
    // Center the active item
    const offset =
      -currentIndex * (items[0].offsetWidth + 20) +
      (carouselInner.offsetWidth - items[0].offsetWidth) / 2;
    carouselInner.style.transform = `translateX(${offset}px)`;
  
    // Update focus state
    updateFocus();
  }
  
  const left_arrow = document.getElementById("left_arrow");
  const right_arrow = document.getElementById("right_arrow");
  
  left_arrow.addEventListener("click", () => slide(-1));
  
  right_arrow.addEventListener("click", () => slide(1));
  
  function updateFocus() {
    const items = document.querySelectorAll(".carousel-item");
  
    items.forEach((item, index) => {
      if (index === currentIndex) {
        item.classList.add(
          "scale-[1]",
          "opacity-100",
          "shadow-[rgb(216,212,212)_-17px_-7px]",
          "cursor-pointer",
          "hover:bg-gray-200"
        );
        item.classList.remove("scale-[0.8]", "opacity-50");
      } else {
        item.classList.remove(
          "scale-[1]",
          "opacity-100",
          "shadow-[rgb(216,212,212)_-17px_-7px]",
          "cursor-pointer",
          "hover:bg-gray-200"
        );
        item.classList.add("scale-[0.8]", "opacity-50");
      }
    });
  }
  
  // Initial centering and focus
  const initialOffset =
    -currentIndex * (items[0].offsetWidth + 20) +
    (carouselInner.offsetWidth - items[0].offsetWidth) / 2;
  carouselInner.style.transform = `translateX(${initialOffset}px)`;
  updateFocus();
  // Carousel end

</script>