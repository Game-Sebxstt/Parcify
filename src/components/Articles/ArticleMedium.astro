---
interface Props{
    first_text: string;
}

const {first_text} = Astro.props;
---

<div class="absolute flex justify-center items-center w-[90%] mx-auto">
    <button class="arrow-button arrow-left text-white bg-transparent border-none text-[50px] cursor-pointer z-10 translate-x-1/2" id="left_arrow">
      <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="white" class="icon icon-tabler icons-tabler-filled icon-tabler-square-rounded-chevron-right w-12 h-12 rotate-180 ">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M12 2c-.218 0 -.432 .002 -.642 .005l-.616 .017l-.299 .013l-.579 .034l-.553 .046c-4.785 .464 -6.732 2.411 -7.196 7.196l-.046 .553l-.034 .579c-.005 .098 -.01 .198 -.013 .299l-.017 .616l-.004 .318l-.001 .324c0 .218 .002 .432 .005 .642l.017 .616l.013 .299l.034 .579l.046 .553c.464 4.785 2.411 6.732 7.196 7.196l.553 .046l.579 .034c.098 .005 .198 .01 .299 .013l.616 .017l.642 .005l.642 -.005l.616 -.017l.299 -.013l.579 -.034l.553 -.046c4.785 -.464 6.732 -2.411 7.196 -7.196l.046 -.553l.034 -.579c.005 -.098 .01 -.198 .013 -.299l.017 -.616l.005 -.642l-.005 -.642l-.017 -.616l-.013 -.299l-.034 -.579l-.046 -.553c-.464 -4.785 -2.411 -6.732 -7.196 -7.196l-.553 -.046l-.579 -.034a28.058 28.058 0 0 0 -.299 -.013l-.616 -.017l-.318 -.004l-.324 -.001zm-1.707 6.293a1 1 0 0 1 1.32 -.083l.094 .083l3 3a1 1 0 0 1 .083 1.32l-.083 .094l-3 3a1 1 0 0 1 -1.497 -1.32l.083 -.094l2.292 -2.293l-2.292 -2.293a1 1 0 0 1 -.083 -1.32l.083 -.094z" fill="currentColor" stroke-width="0" />
      </svg>
    </button>

    <div class="carousel flex overflow-hidden justify-center items-center h-full w-full">
      <div class="carousel-inner flex transition-transform ease-in-out duration-500" id="carousel-inner">
        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[1] opacity-100 shadow-[rgb(216,212,212)_-17px_-7px] text-black">
          {first_text}
        </div>

        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[0.8] opacity-50 text-black">
          {first_text}
        </div>

        <div class="carousel-item transition-transform duration-500 ease w-[300px] h-[200px] mx-[10px] bg-white rounded-[2px] flex justify-center items-center text-[24px] scale-[0.8] opacity-50 text-black">
          {first_text}
        </div>
      </div>
    </div>

    <button class="arrow-button arrow-right text-white bg-transparent border-none text-[50px] cursor-pointer z-10 -translate-x-1/2" id="right_arrow">
      <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-right w-12 h-12">
        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
        <path d="M9 6l6 6l-6 6" />
      </svg>
    </button>
</div>