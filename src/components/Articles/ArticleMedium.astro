---
interface Props{
    class_article: string;
    first_text: string;
}

const {class_article, first_text} = Astro.props;
---

<div class=`cursor-pointer hover:scale-[1.03] transition-all duration-200 ease-in w-full h-full ${Astro.props.class_article}`>
    <div class="relative bg-[#E6E6E6] w-full h-full rounded-md shadow-md shadow-black">
        <footer class="absolute bottom-0 bg-[#FB7F53] rounded-b-sm w-full h-fit flex px-2 py-2 items-center justify-center">
            <p class="text-white text-lg font-bold">{first_text}</p>
        </footer>
    </div>
</div>