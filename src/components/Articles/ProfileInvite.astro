---
interface Props{
    letter: string;
    color: string;
}

const {letter, color} = Astro.props;
---

<div id="profile-invite" class=`w-8 h-8 rounded-full flex justify-center items-center text-center text-white font-lighter text-base cursor-pointer text-xs ${Astro.props.color}`>
    {letter}
</div>