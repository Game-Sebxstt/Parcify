---
import Template from "../Articles/Template.astro";
import TemplateView from "../Articles/TemplateView.astro";
import Article from "../Articles/Article.astro";
import { getAllTemplates, getFavorites } from "../../js/backend/requests";

// Obtener el ID del usuario
const id = Astro.cookies.get("ID-USER")?.value;
let getDataUser:any = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
let dataUser = await getDataUser.json();

let getTemplates:any = await getAllTemplates();
let getFavorite:any = await getFavorites(id)

let isDataFavorite = getFavorite.state ? true : false;

let arrayFavorites:any;
let arrayProjects:any = [];
let arrayTemplates:any = [];

let filteredProjects;
let filteredTemplates;

if (isDataFavorite) {
    // Cargar proyectos y plantillas en arrays
    dataUser.message.projects.forEach((element:any) => {
        arrayProjects.push({
            id:element.project_id,
            name:element.name,
            edited:element.last_modified,
            preview:element.preview,
            collaborators:element.collaborators,
            stage:element.stage,
        });
    });

    getTemplates.data.message.forEach((element:any) => {
        arrayTemplates.push({
            id:element.template_id,
            name:element.name,
            author:element.autor,
            likes:element.likes,
            url_image:element.preview,
            description:element.description,
        });
    });

    getFavorite.data.message.forEach((element:any) => {
        arrayFavorites = JSON.parse(element.favorites)
    });

    // Filtrar proyectos y plantillas según los favoritos
    filteredProjects = arrayProjects.filter((project:any) => 
        arrayFavorites.some((fav:any) => fav.id === project.id && fav.type === "project")
    );

    filteredTemplates = arrayTemplates.filter((template:any) => 
        arrayFavorites.some((fav:any) => fav.id === template.id && fav.type === "template")
    );
}

---

<section id="moreFavorites" class="fixed w-full h-full z-50 hidden justify-center items-center bg-black/80">
    <!-- caja principal -->
    <section class="max-w-[72rem] h-[40rem] max-h-[60rem] bg-[#1E1E1E] rounded-md p-3 flex flex-col gap-2 animate-deployment">
        <!-- encabezado -->
        <header class="flex items-center justify-between">
            <div class="flex items-center gap-1">
                <img src="/Logo-no-background-no-text.png" class="h-10"/>
                <h3 class="text-xl font-bold text-white">Parcify</h3>
            </div>
            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>
        <hr class="border-blue-500">

        <!-- contenido -->
        <main class="h-full p-2 grid grid-cols-2 gap-5 overflow-auto">
            <!-- Renderizar Proyectos Favoritos -->
            {
                filteredProjects && filteredProjects.length > 0 ? (
                    filteredProjects.map((project:any) => (
                        <Article
                        id="projectFavorite"
                        last_modified={project.edited}
                        name={project.name}
                        preview={project.preview}
                        project_id={project.id}
                        collaborators={project.collaborators}
                        stage={project.stage}
                        ></Article>
                    ))
                ):(
                    <span></span>
                )
            } 

            <!-- Renderizar Plantillas Favoritas -->
            {
                filteredTemplates && filteredTemplates.length > 0 ? (
                    filteredTemplates.map((template:any) => (
                        <TemplateView
                            id=""
                            first_text={template.name}
                            second_text={template.author}
                            url_image={template.url_image}
                            template_id={template.id}
                            description={template.description}
                            likes={template.likes}
                        ></TemplateView>
                    ))
                ) : (
                    <span></span>
                )
            }
        </main>
    </section>
</section>
