---
import Template from "../Articles/Template.astro"
---
<section id="moreFavorites" class="fixed w-full h-full z-50 hidden justify-center items-center bg-black/80">
    <!-- caja principal -->
    <section class="max-w-[72rem] h-[40rem] max-h-[60rem] bg-[#1E1E1E] rounded-md p-3 flex flex-col gap-2 animate-deployment">
        <!-- encabezado -->
        <header class="flex items-center justify-between">
            <div class="flex items-center gap-1">
                <img src="/Logo-no-background-no-text.png" class="h-10"/>
                <h3 class="text-xl font-bold text-white">Parcify</h3>
            </div>
            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>
        <hr class="border-blue-500">

        <!-- contenido -->
        <main class="h-full p-2 grid grid-cols-3 gap-5 overflow-auto">
            <div class="relative h-[15rem] w-[20rem] flex flex-col items-center gap-2 p-2 cursor-pointer">
                <Template clase="h-[13rem] w-full" name="Untitled" description="jausjaus" likes="12K" typeElement=""></Template>
                <svg class="absolute -top-[1%] left-[94%]"  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="#fbff00"  ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z" /></svg>
            </div>
        </main>
    </section>
</section>