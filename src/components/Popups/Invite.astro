---
import ProfileInvite from "../Articles/ProfileInvite.astro";

import * as lastModified from '../Articles/Article.astro';

interface Props{
    data: any,
}

const {data} = Astro.props;
let new_last_modified: any;

if(data.projects[0] && data.projects[0].last_modified){
    new_last_modified = lastModified.lastModified([data.projects[0].last_modified])
}

---

<div id="popup-invite" class="w-screen h-screen fixed z-50 hidden justify-center items-center max-sm:px-3">
    <div id="bg-close-invite" class="absolute left-0 bg-close w-full h-full backdrop-blur bg-black/50 cursor-pointer"></div>

    <div id="projectContent" class="flex flex-col h-fit w-[30rem] max-sm:w-full max-sm:rounded-none p-2 bg-[#353535] rounded-lg z-10  animate-deployment">
        <header class="w-full flex justify-between items-center p-2 border-b-[1px] border-blue-500">
            <h3 class="text-xl text-white font-bold max-md:text-base">
                Share the parcellers with your friends
            </h3>

            <span id="x-close-invite" class="w-fit h-fit p-1 hover:bg-slate-300/30 transition-all duration-150 ease-in rounded-sm cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-x h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M18 6l-12 12" />
                    <path d="M6 6l12 12" />
                </svg>
            </span>
        </header>

        <section class="flex flex-col gap-5 py-5" id="projects-box">
            {
                data.projects.map((item: any) => (
                    <article data-id={item.project_id} class="flex items-center gap-3 p-3 rounded box-border border-2 border-transparent relative w-full" id="parceler-box">
                        <label for={item.project_id} class="w-full h-full flex items-center bg-transparent absolute z-10"></label>
                        <input type="checkbox" id={item.project_id} class="h-5 w-5 projectSelected hidden" id="parceler-selected">
                        <div class=" h-16 w-24 bg-[#f5f5f5] rounded-md shadow-md shadow-black">
                            {
                                item.preview ? (
                                    <img src={item.preview} class="w-full h-full">
                                ) : (
                                    <img src="../../../public/placeholder/image_preview.svg" class="w-full h-full">
                                )
                            }
                        </div>
                        <p class="flex flex-col max-md:text-sm">{item.name}<span class="opacity-50 max-md:text-sm">Editado hace {new_last_modified}</span></p>
                    </article>
                ))
            }

            {
                data.projects.length < 1 ? (
                    <span class="w-full px-3 text-white font-bold text-lg">
                        No se encontraron proyectos
                    </span>
                ) : (
                    <span class="hidden"></span>
                )
            }
            
        </section>

        <footer class="w-full h-fit py-5 flex justify-center items-center px-3 border-t-[1px] border-blue-500">
            <button id="continue" class="bg-[#1E90FF] hover:bg-[#1E90FF]/90 active:bg-[#1E90FF]/70 text-white px-3 py-1.5 rounded-sm">
                Continue
            </button>
        </footer>
    </div>

    <div id="users-invited" class="hidden flex-col w-[30rem] max-sm:w-full max-sm:rounded-none p-2 bg-[#353535] rounded-lg z-10  animate-deployment">
        <header class="w-full flex justify-between items-center p-2 ">
            <h3 class="text-xl text-white font-bold">
                Share the parcellers with your friends
            </h3>

            <span id="x-close-invite" class="w-fit h-fit p-1 hover:bg-slate-300/30 transition-all duration-150 ease-in rounded-sm cursor-pointer">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-x h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M18 6l-12 12" />
                    <path d="M6 6l12 12" />
                </svg>
            </span>
        </header>

        <section class="flex flex-col gap-5 p-4">
            <div class="flex flex-col gap-2 py-4 pl-4 border-l-2 border-[#1E90FF] transition-all hover:bg-[#575757]">
                <h2 class="text-gray-300 font-bold">
                    Collaborators in your Parceller
                </h2>
                
                <div class="flex gap-2 pl-3">
                    <ProfileInvite color="bg-green-500" letter="S"/>
                    <ProfileInvite color="bg-purple-500" letter="D"/>
                    <ProfileInvite color="bg-red-500" letter="Y"/>
                </div>
            </div>

            <div class="flex flex-col gap-2 py-4 pl-4 border-l-2 border-[#1E90FF] transition-all hover:bg-[#575757]">
                <h2 class="text-gray-300 text-base font-bold">
                    Members Access
                </h2>

                <div class="flex gap-16 max-[430px]:gap-6 px-3 w-full justify-start items-center">
                    <div class="flex gap-3 items-center justify-center">
                        <ProfileInvite color="bg-[#FB7F53]" letter="N"/>

                        <span class="text-white text-lg max-sm:text-base font-semibold">
                            New member
                        </span>
                    </div>

                    <div class="flex items-end">
                        <div class="relative w-fit flex flex-col gap-1">
                            <div id="filter" class="flex items-end gap-2 cursor-pointer bg-[#555555] px-3 py-0.5 rounded-sm transition-all hover:bg-[#2b2929]">
                                <div class="w-fit h-fit flex items-center gap-2">
                                    <span id="text-select" class="text-white font-bold text-base cursor-pointer w-fit h-fit" data-value="View">
                                        View
                                    </span>
                                </div>
            
                                <svg id="arrow-down-filter" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-down h-6 cursor-pointer transition-all duration-200 ease-in">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M6 9l6 6l6 -6"/>
                                </svg>
                            </div>
                            
                            <ul id="more-options-filter" class="absolute mt-8 bg-[#2b2929] rounded-sm shadow-lg shadow-[#181818] w-full hidden flex-col justify-center item-start text-white animate-deployment">
                                <li class="hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-t-sm" data-filter="test">
                                    Can view
                                </li>
                                <li class="hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-2 py-1 rounded-b-sm" data-filter="test">
                                    Can edit
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </section>
        <footer class="w-full h-fit py-5 flex justify-start items-center px-3">
            <button class="group relative bg-[#1E90FF] hover:bg-[#1E90FF]/90 active:bg-[#1E90FF]/70 text-white px-3 py-1.5 rounded-sm">
                Copy Link
                <div class="hidden  group-focus:block">
                    <div class="group absolute -top-12 left-1/2 z-50 flex -translate-x-1/2 flex-col items-center rounded-sm text-center text-sm text-slate-300 before:-top-2">
                        <div class="rounded-sm bg-black py-1 px-2">
                            <p class="whitespace-nowrap">The link was copied successfully!</p>
                        </div>
                        <div class="h-0 w-fit border-l-8 border-r-8 border-t-8 border-transparent border-t-black"></div>
                    </div>
                </div>
            </button>
        </footer> 
    </div>
</div>