---
// Definición de la interfaz Props
interface Props {
  id: string;
  message: string;
}


const { id, message } = Astro.props;
---

<!--Hidden -> display: none; -->

<!-- Alerta de error -->
<div id={id} class="hidden items-center w-full fixed top-5 animate-deployment max-w-xs p-4 mb-4 text-gray-500 bg-white rounded-lg shadow dark:text-gray-400 dark:bg-gray-800" role="alert">
  <div class="inline-flex items-center justify-center flex-shrink-0 w-8 h-8 text-red-500 bg-red-100 rounded-lg dark:bg-red-800 dark:text-red-200">
    <svg aria-hidden="true" class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
      <path d="M10 .5a9.5 9.5 0 1 0 9.5 9.5A9.51 9.51 0 0 0 10 .5Zm3.707 11.793a1 1 0 1 1-1.414 1.414L10 11.414l-2.293 2.293a1 1 0 0 1-1.414-1.414L8.586 10 6.293 7.707a1 1 0 0 1 1.414-1.414L10 8.586l2.293-2.293a1 1 0 0 1 1.414 1.414L11.414 10l2.293 2.293Z" />
    </svg>
    <span class="sr-only">Error icon</span>
  </div>
  <div id= "txt"class="ml-3 text-sm font-normal">{message}</div>
  <button id="close-danger" type="button" class="ml-auto -mx-1.5 -my-1.5 bg-white justify-center items-center text-gray-400 hover:text-gray-900 rounded-lg focus:ring-2 focus:ring-gray-300 p-1.5 hover:bg-gray-100 inline-flex h-8 w-8 dark:text-gray-500 dark:hover:text-white dark:bg-gray-800 dark:hover:bg-blue-700" data-dismiss-target={`#${id}-danger`} aria-label="Close">
    <span class="sr-only">Close</span>
    <svg aria-hidden="true" class="w-3 h-3" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 14 14" xmlns="http://www.w3.org/2000/svg">
      <path d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6" />
    </svg>
  </button>
</div>


<script>

  const close = document.querySelectorAll("#close-danger") as NodeListOf<HTMLButtonElement>

  close.forEach(item => {
    item?.addEventListener("click", () => {
    (item.parentNode as HTMLElement).style.display = "none";
  })
  })


</script>