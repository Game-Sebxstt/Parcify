---
import TemplateView from '../Articles/TemplateView.astro';
import Templates from '../Sections/Categories/Templates.astro';

interface Props{
    id_content: string,
}

const {id_content} = Astro.props;

---

<div id={id_content} class="content-all fixed z-50 hidden animate-deployment justify-center items-center w-full h-full px-3">
   
    <div id="close-bg" class="w-full h-full absolute top-0 left-0 cursor-pointer bg-black/80 z-0"></div>

    <!-- All content popup -->
    <div class="bg-[#1E1E1E] w-full max-w-5xl h-[95%] shadow-gray-900 rounded-lg z-10 flex flex-col">
        <header class="px-5 py-3 border-b border-[#FB7F53] flex flex-row items-center justify-between">
        
            <div class="flex items-center gap-3 relative w-[20rem] max-sm:w-fit">
                <svg  class="icon icon-tabler icons-tabler-outline icon-tabler-search h-6 absolute left-2.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                    <path d="M21 21l-6 -6" />
                </svg>
                <input type="search" placeholder="Search templates" class="bg-[#484848] rounded-sm py-1.5 text-lg outline-none pl-11 pr-3 w-full text-white max-[880px]:w-full">
            </div>

            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>

        <!-- section Popup -->
        <section class="w-full h-full px-5 py-3 gap-y-3 overflow-x-auto">
            <Templates category='Recomendados'>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
            </Templates>

            <Templates category='Educativos'>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
            </Templates>

            <Templates category='Empresariales'>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
                <TemplateView first_text='Plantilla Vacia' second_text='by Parcify'/>
            </Templates>
        </section>
    </div>
 </div>

<script>

let cls_bg = document.querySelectorAll("#close-bg") as NodeListOf<HTMLButtonElement>;

cls_bg.forEach(item =>  {
    item.addEventListener ('click', () => {
        (item.parentNode as HTMLElement).style.display = "none";
    });
})

let cls_btn = document.querySelectorAll("#close-button") as NodeListOf<HTMLButtonElement>;

cls_btn.forEach(item =>  {
    item.addEventListener ('click', () => {
        (item.parentNode?.parentNode?.parentNode as HTMLElement).style.display = "none";
    });
})

    
</script>

    
