---

---

<div class="flex-col" id="sub_sections_configurations">
    <div class=" w-full h-fit border-b-2 border-[#757575] pb-2 mb-3">
        <h1 class="text-[#FFFFFF] text-xl pb-3 font-medium">
           <!--Titulo -->
           Appearance Settings
        </h1>
        <h4 class="text-[#FFFFFF] text-sm max-sm:mb-1">
           <!--Subtitulo-->
           Appearance
        </h4>
          <!-- Descripción -->
        <p class="font-light text-sm pb-2 text-[#6a6b6a] max-sm:w-fit">
         Change the way the user interface looks and works on your platform        
        </p>
    </div>

    <!-- Interface theme -->
    <div class="w-full h-fit flex border-b-2 border-[#757575] py-2 mb-2 max-sm:flex-col max-sm:mt-2 max-md:flex-col md:gap-10">
        <span class="w-[55%] max-sm:w-full max-sm:mb-2 max-md:mb-3">
            <h3 class="text-[#FFFFFF] text-sm">Interface theme</h3>
            <h4 class="text-[#757575] text-sm font-light max-sm:w-fit">
                Select or customize your UI theme
            </h4>   
        </span>
        <div class="flex justify-start items-center mb-2  w-full h-full max-sm:mt-2">
            <div class="flex items-center justify-start w-full h-full gap-4 max-sm:flex-col  max-sm:items-start max-md:gap-5">
                <div>
                    <div data-theme="dark" class="theme-option w-44 h-28 mb-2 rounded-xl bg-[#1E1E1E] cursor-pointer max-sm:w-28 sm:h-32">

                    </div>
                    <p class="text-sm">Dark theme</p>
                </div>
                <div>
                    <div data-theme="light" class="theme-option w-44 h-28 mb-2 rounded-xl bg-[#B3B3B3] cursor-pointer max-sm:w-28 sm:h-32">

                    </div>
                    <p class="text-sm">Ligth theme</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Font -->
    <div class="w-full h-fit flex border-b-2 border-[#757575] py-2 mb-2 max-sm:flex-col">
        <span class="w-[55%] max-sm:w-full max-sm:mb-2 md:w-full max-md:w-full">
            <h3 class="text-[#FFFFFF] text-sm">Font theme</h3>
            <h4 class="text-[#757575] text-sm font-light">
                Select or customize your font
            </h4>   
        </span>
        <div class="flex justify-start items-center mb-2  w-full h-full ">
            <div class=" flex items-center justify-start w-full h-full">
                <select name="Font theme" class="py-3 pl-4 bg-[#1E1E1E] outline-none max-sm:w-fit max-sm:text-[14px]">
                    <option value="ubuntu">Ubuntu</option>
                    <option value="ladeuth">Ladeuth</option>
                    <option value="mojao">Ladeuth mojao</option>
                  </select>            
            </div>
        </div>
    </div>

    <!-- Buttons to save changes or cancel -->
    <div id="options-buttons" class="flex gap-4 justify-end w-full z-10" style="display: none;">
        <button type="button" class="bg-[#1E1E1E] text-white text-sm font-base px-4 py-2 rounded-sm mt-4">
            Cancel
        </button>
        <button type="button" class="bg-[#FF7300] text-white text-sm font-base px-4 py-2 rounded-sm mt-4">
          Save Changes
        </button>
      </div>
    </div>  
</div>