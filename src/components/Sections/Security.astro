---

<div class="flex flex-col" id="sub_sections_configurations">
    <div class=" w-full h-fit border-b-2 border-[#757575] pb-2 mb-3 max-sm:w-fit">
        <h1 class="text-[#FFFFFF] text-xl pb-3 font-medium max-sm:text-[14px]">
           <!--Titulo -->
           Security Settings
        </h1>
        <h4 class="text-[#FFFFFF] text-sm max-sm:text-[12px]">
           <!--Subtitulo-->
           Security
        </h4>
        <p class="font-light text-sm pb-2 text-[#6a6b6a] max-sm:text-[10px]">
            <!-- Descripción -->
            Change the way the user interface looks and works on your platform
        </p>
    </div>

    <!-- Cambio de contraseña -->
    <div class="py-4 mb-2 w-full h-fit flex border-b-2 border-[#757575] max-sm:flex-col">
        <span class="w-[35%] max-sm:w-full md:w-[50%]">
          <h3 class="text-[#FFFFFF] text-sm">Password</h3>
          <h4 class="text-[#757575] text-sm font-light">
             Change your password
          </h4>
        </span>

        <!-- Espacio para el cambio de contraseña -->
        <div class="flex-col w-full h-full "> 
            <div class="flex w-full max-sm:flex-col sm:flex-col">
                <div class="flex w-full gap-4 items-center">
                    <input
                        type="password"
                        id="password"
                        name="password"
                        readonly
                        class="w-[50%] bg-[#1E1E1E] opacity-70 text-gray-200 rounded-md px-4 py-2 outline-none mt-1 max-sm:w-[100%] max-sm:text-[8.7px] max-sm:mt-2 max-md:w-[70%] md:text-[12.9px] max-md:text-[12.9px]"
                        placeholder="Enter your password"
                    />
                    <svg id="edit-icon-password"  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  
                    stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-pencil">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                        <path d="M13.5 6.5l4 4" />
                    </svg>
                </div>
            </div>
            <div id="edit-password" class="mt-4 flex-col hidden">
                <div class="flex-col w-full h-full items-center gap-2">
                    <p class="text-[10px]">New password</p>
                    <input
                        type="password"
                        id="newPassword"
                        name="newpassword"
                        class="w-[50%] bg-[#1E1E1E] text-gray-200 rounded-md px-4 py-2 outline-none mt-1 max-sm:w-full max-sm:text-xs max-sm:mt-2 max-md:w-[70%] max-md:text-[12.9px]"
                        placeholder="Enter the new password"
                    />
                </div>
                <div class="mt-4 flex-col w-full h-full items-center gap-2">
                   <p class="text-[10px]">Confirm New Password</p>
                    <input
                        type="password"
                        id="confirmNewPassword"
                        name="confirmNewPassword"
                        class="w-[50%] bg-[#1E1E1E] text-gray-200 rounded-md px-4 py-2 outline-none mt-1 max-sm:w-full max-sm:text-xs max-sm:mt-2 max-md:w-[70%] max-md:text-[12.9px]"
                        placeholder="Confirm your new password"
                    />
                </div>
            </div>
        </div>
    </div>

    <!-- Verificación en 2 pasos -->
    <div class="py-4 mb-2 w-full h-fit flex border-b-2 border-[#757575] max-sm:flex-col">
        <span class="w-full lg:w-[50%] max-sm:w-full max-sm:mb-3 md:w-full max-md:w-full">
          <h3 class="text-[#FFFFFF] text-sm">Two-Step Verification</h3>
          <h4 class="text-[#757575] text-sm font-light">
             Activate it for more security
           </h4>
        </span>

        <div class="w-full"> 
            <label class="inline-flex items-center cursor-pointer">
                <input type="checkbox" value="" class="sr-only peer">
                <div class="relative w-11 h-6 bg-gray-200 peer-focus:outline-none rounded-full peer dark:bg-gray-700 peer-checked:after:translate-x-full rtl:peer-checked:after:-translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:start-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all dark:border-gray-600 peer-checked:bg-[#FF7300]"></div>
            </label>
        </div> 
    </div>  

    <!-- Buttons to save changes or cancel -->
    <div id="options-buttons-password" class="flex gap-4 justify-end" style="display: none;">
        <button id="button-cancel-changes" type="button" class="bg-[#1E1E1E] text-white text-sm font-base px-4 py-2 rounded-sm mt-4">
            Cancel
        </button>
        <button id="button-save-security" type="button" class="bg-[#FF7300] text-white text-sm font-base px-4 py-2 rounded-sm mt-4">
          Save Changes
        </button>
      </div>      
</div>