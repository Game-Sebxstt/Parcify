---
import * as globals from '../../js/frontend/utilities/globals';
interface Props {
    username: string;
    email: string;
    biography: string;
}

const {username, email, biography} = Astro.props;
let emailFormatt = globals.formatEmail(email);
---

<div class="flex flex-col">
    <div class=" w-full h-fit border-b-2 border-[#757575] pb-2 mb-3">
        <h1 class="text-[#FFFFFF] text-xl pb-3 font-medium">
           <!--Titulo -->
           Profile Settings
        </h1>
        <h4 class="text-[#FFFFFF] text-sm">
           <!--Subtitulo-->
           Profile
        </h4>
          <!-- Descripción -->
          <p class="font-light text-sm pb-2 text-[#6a6b6a] ">Change essential information in your profile</p>
    </div>
  
    <!-- Edit profile picture -->
    <div class="w-full h-fit flex-col border-b-2 border-[#757575] py-2 mb-2">
        <span class="w-[55%]">
            <h3 class="text-[#FFFFFF] text-sm">Profile Photo</h3>
            <h4 class="text-[#757575] text-sm font-light">
               Edit or Delete your profile photo
            </h4>   
        </span>
        <div class="flex mt-2 justify-start items-center mb-2 w-full h-fit">
            <div class="flex items-center justify-start w-full h-fit">
                <label id="image-container" for="image-upload" class=" rounded-[50%] w-32 h-32 bg-[#2B2B2B] flex flex-col items-center justify-center border-2 border-[#626362] cursor-pointer ">
                    <div class="flex flex-col items-center justify-center pt-5 pb-6 w-full">
                        <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  
                         stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-edit">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M7 7h-1a2 2 0 0 0 -2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2 -2v-1"/>
                            <path d="M20.385 6.585a2.1 2.1 0 0 0 -2.97 -2.97l-8.415 8.385v3h3l8.385 -8.415z"/>
                            <path d="M16 5l3 3" />
                        </svg>
                    </div>
                    <input id="image-upload" type="file" accept="image/*" class="hidden"/>
                </label>
            </div>    
        </div>
    </div>

    <!-- Edit username -->
    <div class="py-4 mb-2 w-full h-fit flex border-b-2 border-[#757575] max-sm:flex-col">
        <span class="w-[55%] max-sm:w-full max-md:w-full">
          <h3 class="text-[#FFFFFF] text-sm">Username</h3>
          <h4 class="text-[#757575] text-sm font-light">
             Edit your username
          </h4>
        </span>
        <div class="flex w-full h-full items-center gap-2">
            <input
                type="text"
                id="profile-username"
                name="username"
                readonly
                value= {username}
                class="w-[50%] bg-[#1E1E1E] opacity-70 text-gray-200 rounded-md px-4 py-2 outline-none mt-1 max-sm:w-full max-sm:text-xs max-sm:mt-2 max-md:w-[70%] max-md:text-[12.9px]"
                placeholder="Enter new username"
            />
            <div class="flex items-center">
                <div class="relative group flex items-center">
                  <svg id="edit-icon-username" class="cursor-pointer icon icon-tabler icon-tabler-pencil" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                    <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                    <path d="M13.5 6.5l4 4" />
                  </svg>
                  <!-- Texto oculto que aparece al hacer hover -->
                  <span class="ml-2 opacity-0 group-hover:opacity-100 group-hover:ml-2 duration-300 text-white text-sm">
                    Editar
                  </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit email -->
    <div class="py-4 mb-2 w-full h-fit flex border-b-2 border-[#757575] max-sm:flex-col">
        <span class="w-[55%] max-sm:w-full max-md:w-full">
          <h3 class="text-[#FFFFFF] text-sm">Email</h3>
          <h4 class="text-[#757575] text-sm font-light">
            Edit your email
        </h4>
        </span>
        <div id="div-edit-email" class="flex flex-col w-full items-center gap-2">
            <div class="w-full flex items-center">
                <input
                    type="email"
                    id="profile-email"
                    name="email"
                    class="w-[50%] opacity-70 bg-[#1E1E1E] text-gray-200 rounded-md px-4 py-2 outline-none mt-1 max-sm:w-full max-sm:text-xs max-sm:mt-2 max-md:w-[70%] max-md:text-[12.9px]"
                    readonly
                    value={emailFormatt}
                    placeholder="Enter your email"
                />
                <div class="flex items-center ml-2">
                    <!-- Contenedor del icono y el texto -->
                    <div class="relative group flex items-center">
                      <!-- Icono de lápiz -->
                      <svg id="edit-icon-email" class="cursor-pointer icon icon-tabler icon-tabler-pencil" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                        <path d="M4 20h4l10.5 -10.5a2.828 2.828 0 1 0 -4 -4l-10.5 10.5v4" />
                        <path d="M13.5 6.5l4 4" />
                      </svg>

                      <span class="ml-2 opacity-0 group-hover:opacity-100 group-hover:ml-2 duration-300 text-white text-sm">
                        Editar
                      </span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Biography -->
    <div class="py-4 mb-4 w-full h-fit flex border-b-2 border-[#757575] max-sm:flex-col">
        <span class="w-[55%] max-sm:w-full max-md:w-full">
          <h3 class="text-[#FFFFFF] text-sm">Your Bio</h3>
          <h4 class="text-[#757575] text-sm font-light">
             Customize your biography
          </h4>
        </span>
        <div class="flex w-full">
            <textarea
                id="textarea-biography"
                name="biography"
                class="w-[50%] bg-[#1E1E1E] resize-none text-gray-200 rounded-md px-4 py-2 outline-none mt-1  max-sm:w-full max-sm:text-xs max-sm:mt-2 max-md:w-[70%] max-md:text-[12.9px]"
                placeholder="Biographical username"
            >{biography}</textarea>
        </div>
    </div>

    <!-- Buttons to save changes or cancel -->
    <div id="options-buttons-profile" class="flex gap-4 justify-end mb-4" style="display: none;">
        <button id="button-cancel-changes" type="button" class="bg-[#1E1E1E] text-white text-sm font-base px-4 py-2 rounded-sm mt-4 transition-colors duration-400 border border-[#FF0000] hover:bg-transparent hover:text-[#FF0000]">
            Cancel
        </button>
        <button id="button-save-changes" type="button" class=" bg-[#FF7300] text-white text-sm font-base px-4 py-2 rounded-sm mt-4 transition-colors duration-400 border border-[#FF7300] hover:bg-transparent hover:text-[#FF7300]">
            Save Changes
        </button>
  </div>
</div>  