---
interface Props{
    header_text: string;
    color: string;
}

const {color, header_text} = Astro.props;

---

<header class="header-page fixed right-0 z-20">
    <div class="w-full h-fit py-3 bg-[#2b2929] border-b-[1px] border-slate-500 flex justify-between items-center px-4">
        <div class="flex justify-start items-center gap-3">
            <div id="menu-header" class="mr-2 hover:bg-slate-300/10 transition-all duration-150 ease-in rounded-none px-1.5 py-1 hidden max-md:flex">
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="1"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 6l16 0" />
                    <path d="M4 12l16 0" />
                    <path d="M4 18l16 0" />
                </svg>
            </div>

            <span class=`w-fit h-fit rounded-sm ${Astro.props.color}`>
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="white"  class="icon icon-tabler icons-tabler-filled icon-tabler-point h-10 max-sm:h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 7a5 5 0 1 1 -4.995 5.217l-.005 -.217l.005 -.217a5 5 0 0 1 4.995 -4.783z" />
                </svg>
            </span>
    
            <h3 class="text-2xl text-white font-semibold max-sm:text-lg">{header_text}</h3>
        </div>
    
        <div class="cursor-pointer">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-user-circle h-10 max-sm:h-8">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                <path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
            </svg>
        </div>
    </div>
</header>


<style>
	.header-page{
		width: calc(100% - 20rem);
	}

	@media (max-width: 768px) {
		.header-page{
			width: 100%;
		}
	}
</style>