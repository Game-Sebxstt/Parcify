---

interface Props{
    header_text: string;
    color: string;

    //Data
    username: string,
    email:string
}

const {color, header_text, username, email} = Astro.props;

---

<header class="header-page fixed right-0 z-20">
    <div class="w-full h-fit py-3 bg-[#2b2929] border-b-[1px] border-blue-400 flex justify-between items-center px-4">
        <div class="flex justify-start items-center gap-3">
            <div id="menu-header" class="mr-2 hover:bg-slate-300/10 transition-all duration-150 ease-in rounded-none px-1.5 py-1 hidden max-md:flex">
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="1"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 6l16 0" />
                    <path d="M4 12l16 0" />
                    <path d="M4 18l16 0" />
                </svg>
            </div>

            <span class=`w-fit h-fit rounded-sm ${Astro.props.color}`>
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="white"  class="icon icon-tabler icons-tabler-filled icon-tabler-point h-10 max-sm:h-8">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 7a5 5 0 1 1 -4.995 5.217l-.005 -.217l.005 -.217a5 5 0 0 1 4.995 -4.783z" />
                </svg>
            </span>
    
            <h3 class="text-2xl text-white font-semibold max-sm:text-lg">{header_text}</h3>
        </div>
    
        <!-- menu -->
        <div class="cursor-pointer relative px-1">
            <div id="userInfo" class="flex items-center gap-2">
                <p id="username" class="font-semibold text-xl">{username}</p>
                <div id="image-container" class="profile h-10 w-10 rounded-full">
                    <svg class="hidden icon icon-tabler icons-tabler-outline icon-tabler-user-circle h-10 max-sm:h-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                        <path d="M12 10m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                        <path d="M6.168 18.849a4 4 0 0 1 3.832 -2.849h4a4 4 0 0 1 3.834 2.855" />
                    </svg>
                </div>
            </div>

            <ul id="more-options-profile" class="absolute -right-[10%] p-2 mt-3 bg-[#474747] rounded-[4px] shadow-md shadow-[#181818] gap-2 hidden flex-col items-center text-white animate-deployment">
                <li id="openSettings" class="flex items-center justify-between gap-2 hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-4 py-2" data-filter="test">
                    <svg class="flex items-center" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M10.325 4.317c.426 -1.756 2.924 -1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543 -.94 3.31 .826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756 .426 1.756 2.924 0 3.35a1.724 1.724 0 0 0 -1.066 2.573c.94 1.543 -.826 3.31 -2.37 2.37a1.724 1.724 0 0 0 -2.572 1.065c-.426 1.756 -2.924 1.756 -3.35 0a1.724 1.724 0 0 0 -2.573 -1.066c-1.543 .94 -3.31 -.826 -2.37 -2.37a1.724 1.724 0 0 0 -1.065 -2.572c-1.756 -.426 -1.756 -2.924 0 -3.35a1.724 1.724 0 0 0 1.066 -2.573c-.94 -1.543 .826 -3.31 2.37 -2.37c1 .608 2.296 .07 2.572 -1.065z" /><path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0" /></svg>
                    <p class="font-medium">Settings</p>
                </li>
                <li id="logout" class="flex items-center justify-between  gap-2 hover:bg-slate-600 transition-all duration-150 ease-in cursor-pointer px-5 py-2 " data-filter="test">
                    <svg class="flex items-center stroke-red-400" xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="red"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M14 8v-2a2 2 0 0 0 -2 -2h-7a2 2 0 0 0 -2 2v12a2 2 0 0 0 2 2h7a2 2 0 0 0 2 -2v-2" /><path d="M9 12h12l-3 -3" /><path d="M18 15l3 -3" /></svg>
                    <p class="text-red-400 font-bold">Logout</p>
                </li>
            </ul>
        </div>
    </div>
</header>


<style>
	.header-page{
		width: calc(100% - 20rem);
	}

	@media (max-width: 768px) {
		.header-page{
			width: 100%;
		}
	}
    @media (max-width: 400px) {
        #username{
            display: none;
        }
	}
</style>