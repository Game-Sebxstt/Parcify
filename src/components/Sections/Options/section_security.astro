---
interface Props{
    state: string,

    username: string,
    email: string
}

const {username, email, state} = Astro.props;
---

<!-- encabezado -->
<div class=`section-config flex flex-col gap-4 ${state} py-2`>
    <header class="flex items-center justify-between">
        <h2 class="text-3xl font-bold">Security</h2>
        <svg id="closeSetting" class="cursor-pointer hover:stroke-red-400 transition-all" xmlns="http://www.w3.org/2000/svg"  width="30"  height="30"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M15 19v-2a2 2 0 0 1 2 -2h2" /><path d="M15 5v2a2 2 0 0 0 2 2h2" /><path d="M5 15h2a2 2 0 0 1 2 2v2" /><path d="M5 9h2a2 2 0 0 0 2 -2v-2" /></svg>
    </header>
    
    <!-- contenido -->
    <main class="flex flex-col gap-4 pr-16">
        <!-- seguridad -->
        <form class="flex flex-col gap-4">
            <article class="flex flex-col gap-2">
                <p>Current password</p>
                <input class="bg-[#292929] border-2 border-[#3e3e3e] rounded-lg text-white px-6 py-3 text-base hover:border-[#FB7F53] outline-none cursor-pointer transition"type="password" required/>
            </article>

            <article class="flex flex-col gap-2">
                <p>New password</p>
                <input class="bg-[#292929] border-2 border-[#3e3e3e] rounded-lg text-white px-6 py-3 text-base hover:border-[#FB7F53] outline-none cursor-pointer transition"type="password" required/>
            </article>

            <article class="flex flex-col gap-2">
                <p>Confirm new password</p>
                <input class="bg-[#292929] border-2 border-[#3e3e3e] rounded-lg text-white px-6 py-3 text-base hover:border-[#FB7F53] outline-none cursor-pointer transition"type="password" required/>
            </article>

            <article>
                <button class="bg-[#FB7F53] py-2 px-3 rounded" type="submit">Cambiar contraseña</button>
            </article>
        </form>
    </main>
</div>