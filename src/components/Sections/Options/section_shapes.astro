---
import BoxShapes from "../../../components/Articles/BoxShapes.astro";

interface Props{
    state: string;
}

const {state} = Astro.props;
---

<div class=`w-full h-fit flex flex-col gap-1 ${state}`>
    <h3 class="text-white font-semibold ml-5 my-3">
        Basic Graphics
    </h3>

    <div class="grid grid-cols-2 grid-rows-1 gap-5 w-full h-full place-items-center px-3">
        <BoxShapes text="Line & Shapes">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-icons h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M6.5 6.5m-3.5 0a3.5 3.5 0 1 0 7 0a3.5 3.5 0 1 0 -7 0" />
                <path d="M2.5 21h8l-4 -7z" />
                <path d="M14 3l7 7" />
                <path d="M14 10l7 -7" />
                <path d="M14 14h7v7h-7z" />
            </svg>
        </BoxShapes>

        <BoxShapes text="Icons">
            <svg class="icon icon-tabler icons-tabler-filled icon-tabler-contrast-2 h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="#FC7F53">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M19 2a3 3 0 0 1 3 3v14a3 3 0 0 1 -3 3h-14a3 3 0 0 1 -3 -3v-14a3 3 0 0 1 3 -3zm0 2h-14a1 1 0 0 0 -1 1v14a1 1 0 0 0 .769 .973c3.499 -.347 7.082 -4.127 7.226 -7.747l.005 -.226c0 -3.687 3.66 -7.619 7.232 -7.974a1 1 0 0 0 -.232 -.026" />
            </svg>
        </BoxShapes>

        <BoxShapes text="Shapes 3D">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-cube h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M21 16.008v-8.018a1.98 1.98 0 0 0 -1 -1.717l-7 -4.008a2.016 2.016 0 0 0 -2 0l-7 4.008c-.619 .355 -1 1.01 -1 1.718v8.018c0 .709 .381 1.363 1 1.717l7 4.008a2.016 2.016 0 0 0 2 0l7 -4.008c.619 -.355 1 -1.01 1 -1.718z" />
                <path d="M12 22v-10" />
                <path d="M12 12l8.73 -5.04" />
                <path d="M3.27 6.96l8.73 5.04" />
            </svg>
        </BoxShapes>
    </div>
</div>