---
import BoxShapes from "../../../components/Articles/BoxShapes.astro";

interface Props{
    state: string;
    id: string;
}

const {state, id} = Astro.props;
---

<div id={id} class=`section_option w-full h-fit flex flex-col gap-1 ${state}`>
    <div>
        <h3 class="text-white font-semibold ml-5 my-3">
            Shapes
        </h3>
    
        <div class="grid grid-cols-2 grid-rows-1 gap-5 w-full h-full place-items-center px-3">
            <BoxShapes id="shape" data_select="square" text="Square">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-square h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M3 3m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
                </svg>
            </BoxShapes>
    
            <BoxShapes id="shape" data_select="triangle" text="Triangle">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-triangle h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" />
                </svg>
            </BoxShapes>
    
            <BoxShapes id="shape" data_select="circle" text="Circle">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-circle h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
                </svg>
            </BoxShapes>
    
            <BoxShapes id="shape" data_select="diamond" text="Diamond">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-diamonds h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M10.831 20.413l-5.375 -6.91c-.608 -.783 -.608 -2.223 0 -3l5.375 -6.911a1.457 1.457 0 0 1 2.338 0l5.375 6.91c.608 .783 .608 2.223 0 3l-5.375 6.911a1.457 1.457 0 0 1 -2.338 0z" />
                </svg>
            </BoxShapes>
        </div>
    </div>

    <div>
        <h3 class="text-white font-semibold ml-5 my-3">
            Lines
        </h3>
    
        <div class="grid grid-cols-2 grid-rows-1 gap-5 w-full h-full place-items-center px-3">
            <BoxShapes id="shape" data_select="line" text="Line">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-line h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M6 18m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M18 6m-2 0a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" />
                    <path d="M7.5 16.5l9 -9" />
                </svg>
            </BoxShapes>


            <BoxShapes id="shape" data_select="line_arrow" text="Line Arrow">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-up-right-circle h-12" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="#FC7F53"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M8.464 15.536l9.536 -9.536" />
                    <path d="M18 10v-4h-4" />
                    <path d="M8.414 15.586a2 2 0 1 0 -2.828 2.828a2 2 0 0 0 2.828 -2.828" />
                </svg>
            </BoxShapes>

        </div>
    </div>
</div>