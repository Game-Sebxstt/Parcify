                <h3 class="text-xl font-bold text-white">Parcify</h3>
            </div>

            <div class="cursor-pointer hover:bg-[#353535] transition-all duration-150 ease-in p-1 rounded-sm">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-menu-2 h-6">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 6l16 0" />
                    <path d="M4 12l16 0" />
                    <path d="M4 18l16 0" />
                </svg>
            </div>
        </div>

        <div class="hidden justify-between items-center w-full max-md:flex">
            <div class="cursor-pointer w-full h-full flex items-center justify-center hover:bg-[#353535] transition-all duration-150 ease-in p-1 py-2.5 rounded-sm">
