<div class="fixed w-[25rem] max-xl:w-[20rem] max-sm:w-full h-full bg-[#1E1E1E]">
    <header class="pt-5 px-7 flex justify-between items-center">
        <div class="flex gap-3 justify-center items-center w-fit">
            <img src="../../../public/Logo.jpg" class="h-16 rounded-lg"/>

            <h3 class="text-2xl font-bold text-white">Parcify</h3>
        </div>

        <div class="cursor-pointer hover:bg-slate-700 transition-all duration-150 ease-in p-1 rounded-sm">
