<div id="konvaPickCustom" data-type="align" class="absolute -top-[75px] left-0 hidden -translate-y-full z-[5] pr-2 w-[320px] h-[110px] rounded-lg bg-[#313131] border-[rgba(255,255,255,.2)] border-[1px] opacity-100 justify-start items-center"></div>

<script>
    const BarTool = document.getElementById("konvaPickCustom") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });
</script>
