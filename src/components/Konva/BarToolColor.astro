---

---

<div id="BarToolExtra" data-type="color" class="absolute -top-5 left-0 -translate-y-full z-[5] pr-2 w-fit h-20 rounded-lg bg-[#313131] border-[rgba(255,255,255,.2)] border-[1px] hidden opacity-100 justify-start items-center">
    <div id="nameBar" class="flex justify-center items-center h-full w-full gap-x-2 px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md cursor-pointer">
        <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" id="chevron" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left w-6 h-6">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M15 6l-6 6l6 6" />
        </svg>

        <span id="name" class="text-white text-base">Color</span>
    </div>

    <span class="w-0.5 h-[70%] mx-2 rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_color" class="childBarTool w-fit h-full flex justify-center items-center p-2 gap-x-2">
        <div id="input_color" data-fill="rgb(0 0 0 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-black/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(255 255 255 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-white/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(239 68 68 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-red-500/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(255 193 7 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-yellow-400/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(0 200 83 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-green-500/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(0 122 255 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-blue-500/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="rgb(88 86 214 / 1)" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="bg-indigo-500/70 rounded-sm w-full h-full"></span>
        </div>
        <div id="input_color" data-fill="custom" class="w-10 h-9 border-[2px] border-transparent flex justify-center items-center">
            <span class="custom rounded-sm w-full h-full"></span>
        </div>
    </div>
</div>

<style>

    :root{
        --color: radial-gradient(50% 50% at 50% 50%, #ffffff 0%, transparent 100%), conic-gradient(from 0deg at 50% 50%, red, #ffa800 47.73deg, #ff0 79.56deg, #0f0 121.33deg, #0ff 180.99deg, #00f 238.67deg, #f0f 294.36deg, red 360deg), #c4c4c4;
    }

    .custom{
        background: var(--color);
    }
</style>

<script>
    const BarTool = document.getElementById("BarToolExtra") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });
</script>
