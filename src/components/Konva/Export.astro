---
---
<section id="exportContent" class="fixed h-full w-full bg-black/10 p-2 z-30 hidden items-center justify-center backdrop-blur-sm ">
    <section class="min-w-[25rem] max-w-fit min-h-[50%] max-h-fit bg-[#2b2929] p-3 shadow-lg shadow-[#181818] text-white animate-deployment flex flex-col gap-1">
        <header class="flex items-center justify-between">
            <div class="flex items-center gap-1">
                <h3 class="text-xl font-bold text-white">Export Canva as...</h3>
            </div>
            <button id="close-export" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>
        <hr class="border-[#383838]">
        <form id="exportForm" class="flex flex-col px-3 justify-between gap-2 p-1 flex-1">
            <div class="flex flex-col gap-3 p-2">
                <h1>Type File</h1>
                <div class="flex items-center justify-center gap-2">
                    <label class="flex items-center gap-2 cursor-pointer ml-2">
                        <input type="radio" name="extension" value="png" checked>
                        <p>PNG</p>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer ml-2">
                        <input type="radio" name="extension" value="jpg">
                        <p>JPG</p>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer ml-2">
                        <input type="radio" name="extension" value="jpeg">
                        <p>JPEG</p>
                    </label>
                    <label class="flex items-center gap-2 cursor-pointer ml-2">
                        <input type="radio" name="extension" value="webp">
                        <p>WEBP</p>
                    </label>
                </div>
            </div>
            <div class="flex flex-col gap-2 p-3">
                <h1>Scale</h1>
                <label class="flex items-center gap-3 w-full">
                    <input type="range" class="w-full" id="scaleRange" min="2" max="6" step="2" value="2">
                    <p id="typeScale">2x</p>
                </label>                
            </div>
            <div class="flex flex-col p-3 gap-2 border border-slate-600 rounded-md">
                <h3 class="font-semibold">Preview</h3>
                <div id="previewContenetor" class="bg-gray-600 w-full h-[10rem] p-2 rounded flex items-center justify-center"></div>
                <p class="flex items-center justify-center gap-1">
                    <span id="typeExtension">PNG</span>
                    <svg class="h-[1rem] w-[1rem]"  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="#b0b0b0"  ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 7a5 5 0 1 1 -4.995 5.217l-.005 -.217l.005 -.217a5 5 0 0 1 4.995 -4.783z" /></svg>
                    <span id="typeScale">2x</span>
                </p>
            </div>
            <div class="flex items-center justify-end p-1">
                <button type="submit" class="bg-blue-500 py-2 px-4 rounded-sm">Export</button>
            </div>
        </form>
    </section>
</section>


