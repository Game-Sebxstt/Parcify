---
---
<section id="exportContent" class="fixed h-full w-full bg-black/10 p-2 z-30 hidden items-center justify-center backdrop-blur-sm ">
    <section class="min-w-[25rem] max-w-fit min-h-[50%] max-h-fit bg-[#2b2929] p-2 shadow-lg shadow-[#181818] text-white animate-deployment flex flex-col gap-1">
        <!-- encabezado -->
        <header class="flex items-center justify-between">
            <div class="flex items-center gap-1">
                <h3 class="text-xl font-bold text-white">Export Canva as...</h3>
            </div>
            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>
        <hr class="border-[#383838]">
        <form id="exportForm" class="flex flex-col justify-between flex-1">
            <div class="flex flex-col gap-2 p-3 pt-4">
                <h1>Type File</h1>
                <label class="flex items-center gap-2 cursor-pointer ml-2">
                    <input type="radio" name="extension" value="png">
                    <p>PNG</p>
                </label>
                <label class="flex items-center gap-2 cursor-pointer ml-2">
                    <input type="radio" name="extension" value="jpg">
                    <p>JPG</p>
                </label>
                <label class="flex items-center gap-2 cursor-pointer ml-2">
                    <input type="radio" name="extension" value="jpeg">
                    <p>JPEG</p>
                </label>
                <label class="flex items-center gap-2 cursor-pointer ml-2">
                    <input type="radio" name="extension" value="webp">
                    <p>WEBP</p>
                </label>
            </div>
            <div class="flex items-center justify-end p-1">
                <button class="bg-blue-500 py-2 px-4 rounded-sm">Export</button>
            </div>
        </form>
    </section>
</section>

