---
import BarToolAlign from "./BarToolAlign.astro";
import BarToolBorder from "./BarToolBorder.astro";
import BarToolColor from "./BarToolColor.astro";
import BarToolColorText from "./BarToolColorText.astro";

---

<div id="BarTool" class="absolute top-28 left-28 z-[5] w-full max-w-3xl h-24 p-0 rounded-lg bg-[#313131] border-[1px] flex opacity-0 justify-center items-center">
    <div id="style_color" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="tool_bar_button" data-type="color" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="rgba(255,255,255,1)" class="icon icon-tabler icons-tabler-filled icon-tabler-circle  w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 3.34a10 10 0 1 1 -4.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 4.995 -8.336z" />
            </svg>
        </button>
        <button id="tool_bar_button" data-type="border" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-border-style-2 w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 18v.01" />
                <path d="M8 18v.01" />
                <path d="M12 18v.01" />
                <path d="M16 18v.01" />
                <path d="M20 18v.01" />
                <path d="M18 12h2" />
                <path d="M11 12h2" />
                <path d="M4 12h2" />
                <path d="M4 6h16" />
            </svg>
        </button>
    </div>

    <span class="w-3 h-[80%] rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="font_style" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="tool_bar_button_action" data-type="fontStyle" data-value="bold" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-bold w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 5h6a3.5 3.5 0 0 1 0 7h-6z" />
                <path d="M13 12h1a3.5 3.5 0 0 1 0 7h-7v-7" />
            </svg>
        </button>
        <button id="tool_bar_button_action" data-type="fontStyle" data-value="italic" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-italic w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M11 5l6 0" />
                <path d="M7 19l6 0" />
                <path d="M14 5l-4 14" />
            </svg>
        </button>
    </div>

    <div id="other_functions" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="tool_bar_button_action" data-type="textDecoration" data-value="underline" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-strikethrough w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M5 12l14 0" />
                <path d="M16 6.5a4 2 0 0 0 -4 -1.5h-1a3.5 3.5 0 0 0 0 7h2a3.5 3.5 0 0 1 0 7h-1.5a4 2 0 0 1 -4 -1.5" />
            </svg>
        </button>
        <button id="tool_bar_button" data-type="align" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-align-left w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M4 12l10 0" />
                <path d="M4 18l14 0" />
            </svg>
        </button>
    </div>

    <span class="w-3 h-[80%] rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_font_family" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <!--Section of to font family this is  -->
        <div class="w-full h-full flex justify-center items-center">
            <select id="font_family" class="w-full h-full text-sm px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none bg-transparent">
                <option value="Arial">Arial</option>
                <option value="Arial Black">Arial Black</option>
                <option value="Comic Sans MS">Comic Sans MS</option>
                <option value="Courier New">Courier New</option>
                <option value="Georgia">Georgia</option>
                <option value="Impact">Impact</option>
                <option value="Lucida Console">Lucida Console</option>
                <option value="Lucida Sans Unicode">Lucida Sans Unicode</option>
                <option value="Palatino Linotype">Palatino Linotype</option>
                <option value="Tahoma">Tahoma</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Trebuchet MS">Trebuchet MS</option>
                <option value="Verdana">Verdana</option>
            </select>
        </div>
    </div>

    <div id="style_font_size" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <!--This section is to font size this is input number -->
        <div class="w-full h-full flex justify-center items-center">
            <input id="font_size" type="number" class="w-full h-full px-2 bg-[rgba(30,30,30,.9)] rounded-md outline-none font-bold text-sm text-center" value="12" min="1" max="100">
        </div> 
    </div>

    <BarToolColor/>
    <BarToolBorder/>
    <BarToolAlign/>
    <BarToolColorText/>
</div>

<style>
    .active{
        background-color: rgba(251, 127, 83);
    }

    .desactive{
        background-color: transparent;
    }
</style>

<script>
    import * as konva from "../../konva/js/KonvaLogic";
    import * as GlobalFunctions from "../../konva/js/GlobalFunctions";

    const BarTool = document.getElementById("BarTool") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });

    const toolBarButton = document.querySelectorAll("#tool_bar_button") as NodeListOf<HTMLElement>
    let elementUpdate: HTMLElement | null = null;
    let keyUpdate: string | null = null;

    toolBarButton.forEach((element: HTMLElement) => {
        element.addEventListener("click", () => {
            GlobalFunctions.setUpdateToolBar(false)
            const dataTypeButton = element ? element.getAttribute("data-type") : "default";
            (document.querySelectorAll("#BarToolExtra") as NodeListOf<HTMLElement>).forEach((item: HTMLElement) => {
                const dataTypeItem = item.getAttribute("data-type")

                if (dataTypeButton === dataTypeItem) {
                    elementUpdate = item;
                    keyUpdate = dataTypeItem;
                } else {
                    item.classList.remove("flex")
                    item.classList.add("hidden")
                }
            })

            if (elementUpdate) {
                elementUpdate.classList.remove("hidden")
                elementUpdate.classList.add("flex")
                const dimensionBarToolExtra = konva.getDimensionBarToolExtra(keyUpdate)
                if(dimensionBarToolExtra.width == 0 && dimensionBarToolExtra.height == 0){
                    const dimensionNew = {
                        width: elementUpdate.offsetWidth,
                        height: elementUpdate.offsetHeight,
                    }
                    konva.setDimensionBarToolExtra(dimensionNew, keyUpdate)
                }

                GlobalFunctions.setUpdateToolBar(true)
            }
        });
    });

    const toolBarButtonAction = document.querySelectorAll("#tool_bar_button_action") as NodeListOf<HTMLElement>

    toolBarButtonAction.forEach((item: Element) => {
        item.addEventListener("click", () => {
            const dataTypeButton = item ? item.getAttribute("data-type") : "default";
            const dataValueButton = item ? item.getAttribute("data-value") : "default";

            GlobalFunctions.actionToolBar(dataValueButton, dataTypeButton)
            if(item.classList.contains("active")){
                item.classList.remove("active");
            }else{
                item.classList.add("active");
            }

            toolBarButtonAction.forEach((element: HTMLElement) => {
                const dataTypeElement = element ? element.getAttribute("data-type") : "default";

                if (element !== item && dataTypeButton == dataTypeElement) {
                    element.classList.remove("active");
                }
            })
        })
    })
</script>
