---
import BarToolColor from "./BarToolColor.astro";


---

<div id="BarTool" class="absolute top-28 left-28 z-[5] w-full max-w-3xl h-24 p-0 rounded-lg bg-[#313131] border-[1px] flex opacity-0 justify-center items-center">
    <div id="style_color" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="color_opacity" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="rgba(255,255,255,1)" class="icon icon-tabler icons-tabler-filled icon-tabler-circle  w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 3.34a10 10 0 1 1 -4.995 8.984l-.005 -.324l.005 -.324a10 10 0 0 1 4.995 -8.336z" />
            </svg>
        </button>
        <button id="style_border" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-circle w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
            </svg>  
        </button>
    </div>

    <span class="w-3 h-[80%] rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_aling" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="color_opacity" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-bold  w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M7 5h6a3.5 3.5 0 0 1 0 7h-6z" />
                <path d="M13 12h1a3.5 3.5 0 0 1 0 7h-7v-7" />
            </svg>
        </button>
        <button id="style_border" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-align-left  w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M4 12l10 0" />
                <path d="M4 18l14 0" />
            </svg>
        </button>
    </div>

    <div id="style_font_color" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <button id="color_opacity" class="w-full h-full flex justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-text-color  w-full max-w-7 h-full max-h-7">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M9 15v-7a3 3 0 0 1 6 0v7" />
                <path d="M9 11h6" />
                <path d="M5 19h14" />
            </svg>
        </button>
        <button id="style_border" class="w-full h-full relative flex flex-col justify-center items-center px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="rgba(255,255,255,1)"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-color-picker  w-full max-w-7 h-full max-h-7 mb-0.5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M11 7l6 6" />
                <path d="M4 16l11.7 -11.7a1 1 0 0 1 1.4 0l2.6 2.6a1 1 0 0 1 0 1.4l-11.7 11.7h-4v-4z" />
            </svg>
            </span>
        </button>
    </div>

    <span class="w-3 h-[80%] rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_font_family" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <!--Section of to font family this is  -->
        <div class="w-full h-full flex justify-center items-center">
            <select id="font_family" class="w-full h-full text-sm px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md outline-none bg-transparent">
                <option value="Arial">Arial</option>
                <option value="Arial Black">Arial Black</option>
                <option value="Comic Sans MS">Comic Sans MS</option>
                <option value="Courier New">Courier New</option>
                <option value="Georgia">Georgia</option>
                <option value="Impact">Impact</option>
                <option value="Lucida Console">Lucida Console</option>
                <option value="Lucida Sans Unicode">Lucida Sans Unicode</option>
                <option value="Palatino Linotype">Palatino Linotype</option>
                <option value="Tahoma">Tahoma</option>
                <option value="Times New Roman">Times New Roman</option>
                <option value="Trebuchet MS">Trebuchet MS</option>
                <option value="Verdana">Verdana</option>
            </select>
        </div>
    </div>

    <div id="style_font_size" class="childBarTool w-full h-full flex justify-center items-center p-2 gap-x-2">
        <!--This section is to font size this is input number -->
        <div class="w-full h-full flex justify-center items-center">
            <input id="font_size" type="number" class="w-full h-full px-2 bg-[rgba(30,30,30,.9)] rounded-md outline-none font-bold text-sm text-center" value="12" min="1" max="100">
        </div> 
    </div>

    <BarToolColor/>
</div>

<style>
    #BarTool {
        /* pointer-events: all; */
    }
</style>

<script>
    const BarTool = document.getElementById("BarTool") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });
</script>
