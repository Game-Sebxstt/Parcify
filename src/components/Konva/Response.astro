---
    interface Props{
        message?: string,
    }

    const { message } = Astro.props;
---

<div class="w-full h-fit flex justify-center items-center gap-x-1 rounded-md overflow-hidden relative">
    <div class="bg-green-500 w-full h-fit flex rounded-md overflow-hidden relative">
        <span class="bg-blue-400 w-4"></span>
    
        <p class="text-white text-[10px] font-bold w-fit h-full absolute top-1 left-1 translate-x-1/2 pointer-events-none">
            Sebxstt
        </p>
    
        <p class="text-white text-sm w-full h-fit truncate px-2 pt-5 pb-1">
            {message}
        </p>
    </div>

    <button class="w-fit h-fit">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-x h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M18 6l-12 12" />
            <path d="M6 6l12 12" />
        </svg>
    </button>
</div>