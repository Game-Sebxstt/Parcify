---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Sections/SlideDesktop.astro';
import SlideMobile from '../components/Sections/SlideMobile.astro';
import Content from '../components/Sections/Content.astro';
import Header from '../components/Sections/Header.astro';
import Article from "../components//Articles/Article.astro"
import ArticleMedium from "../components//Articles/ArticleMedium.astro"
import ArticleTemplate from "../components//Articles/ArticleTemplate.astro"
import Invite from '../components/Popups/Invite.astro';
import Filter from '../components/Articles/Filter.astro';
import ArticlePlus from '../components/Articles/ArticlePlus.astro';
import CreateParceller from '../components/Popups/CreateParceller.astro';
import Error from '../components/Popups/Alerts/Error.astro';

const logged = Astro.cookies.get("logged")?.value;
const id = Astro.cookies.get("ID-USER")?.value;

console.log(logged, id)

if(logged != 'true' && !id){
  return Astro.redirect("/SignIn")
}

let get_data: any;
let data: any;

try{
	get_data = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
	data = await get_data.json();
	data = data.message;

	if(data == "El Usuario no existe."){
		Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
		Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
		return Astro.redirect("/SignIn")
	}
	console.log(data)
}catch(e){
	console.log(e)
	Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
    Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	return Astro.redirect("/SignIn")
}



---

<Layout title="Parcify">
	<div class="w-full h-fit flex">	
		<Header header_text='Management Parcellers' color='bg-purple-500' username={data.users.username}></Header>
		<Slide/>
		<SlideMobile/>
		<CreateParceller id_content='content-create-parcel'/>
		<Invite/>
		<Content>
			<article class="w-full h-64 grid grid-cols-4 max-xl:grid-cols-3 max-[980px]:grid-cols-2 max-sm:grid-cols-1 grid-rows-1 gap-3">
				<ArticleMedium class_article="max-xl:hidden" first_text='Parcelador Básico'/>
				<ArticleMedium class_article="max-[980px]:hidden" first_text='Parcelador Básico'/>
				<ArticleMedium class_article="max-sm:hidden" first_text='Parcelador Básico'/>
				<ArticleTemplate class_article="" first_text='Parcelador Básico'/>
			</article>
	
			<article class="w-full flex flex-col p-4 bg-[#383838] rounded-md shadow-lg shadow-[#181818]">
				<Filter/>
			</article>

			<article class="w-full">
				<div id="content-grid" class="w-full grid grid-cols-3 max-xl:grid-cols-2 max-[980px]:grid-cols-1 gap-5 gap-y-10 overflow-hidden">
					<ArticlePlus/>
					{
						data.projects.map((item: any) => (
							<Article name={item.name} project_id={item.project_id} preview={item.preview} stage={item.stage} collaborators={item.collaborators} last_modified={item.last_modified} />
						))
					}
				</div>
			</article>
		</Content>
	</div>
</Layout>