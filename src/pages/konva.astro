---
import SectionShapes from "../components/Sections/Options/section_shapes.astro";
import SectionTemplates from "../components/Sections/Options/section_templates.astro";
import SectionImages from "../components/Sections/Options/section_images.astro";
import SectionIcons from "../components/Sections/Options/section_icons.astro";
import SectionFolders from "../components/Sections/Options/section_folders.astro";
import SectionPlugins from "../components/Sections/Options/section_plugins.astro";
import ProfileInvite from "../components/Articles/ProfileInvite.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout title="Parcify - Konva">
    <div class="w-full h-screen flex flex-col">
        <div class="w-full h-fit py-2.5 bg-[#383838] flex justify-between px-3 border-b-2 border-[#FC7F53]">
            <div class="w-fit h-full flex items-center gap-3">
                <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-grid h-8 max-[980px]:h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                        <path d="M14 4m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                        <path d="M4 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                        <path d="M14 14m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v4a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                    </svg>
                </span>

                <div class="flex flex-col w-fit h-fit">
                    <h3 class="w-fit h-fit text-md text-white font-semibold">
                        Parcelador Presentations
                    </h3>
                    <h4 class="w-fit h-fit text-sm text-gray-300">
                        By Sebxstt
                    </h4>
                </div>

                <span class="w-fit h-fit p-1 cursor-pointer">
                    <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="white"  class="icon icon-tabler icons-tabler-filled icon-tabler-caret-down">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M18 9c.852 0 1.297 .986 .783 1.623l-.076 .084l-6 6a1 1 0 0 1 -1.32 .083l-.094 -.083l-6 -6l-.083 -.094l-.054 -.077l-.054 -.096l-.017 -.036l-.027 -.067l-.032 -.108l-.01 -.053l-.01 -.06l-.004 -.057v-.118l.005 -.058l.009 -.06l.01 -.052l.032 -.108l.027 -.067l.07 -.132l.065 -.09l.073 -.081l.094 -.083l.077 -.054l.096 -.054l.036 -.017l.067 -.027l.108 -.032l.053 -.01l.06 -.01l.057 -.004l12.059 -.002z" />
                    </svg>
                </span>

                <span class="w-[2px] h-1/2 bg-[#696969]"></span>

                <span id="undo" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-back-up h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M9 14l-4 -4l4 -4" /><path d="M5 10h11a4 4 0 1 1 0 8h-1" />
                    </svg>
                </span>

                <span id="redo" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-arrow-forward-up h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M15 14l4 -4l-4 -4" /><path d="M19 10h-11a4 4 0 1 0 0 8h1" />
                    </svg>
                </span>
            </div>

            <div class="w-fit h-full flex items-center gap-3">
                <span class="relative cursor-pointer">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-message h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M8 9h8" /><path d="M8 13h6" />
                        <path d="M18 4a3 3 0 0 1 3 3v8a3 3 0 0 1 -3 3h-5l-5 3v-3h-2a3 3 0 0 1 -3 -3v-8a3 3 0 0 1 3 -3h12z" />
                    </svg>

                    <svg class="absolute icon icon-tabler icons-tabler-filled icon-tabler-point h-5 -top-1 -right-1.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="red">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M12 7a5 5 0 1 1 -4.995 5.217l-.005 -.217l.005 -.217a5 5 0 0 1 4.995 -4.783z" />
                    </svg>
                </span>

                <span class="w-[2px] h-1/2 bg-[#696969]"></span>

                <div class="flex">
                    <ProfileInvite color="bg-green-500" letter="S"/>
                    <ProfileInvite color="bg-purple-500 -ml-2" letter="D"/>
                    <ProfileInvite color="bg-gray-500 -ml-2" letter="3+"/>
                </div>

                <span class="w-[2px] h-1/2 bg-[#696969]"></span>

                <span id="export" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-download h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-2" />
                        <path d="M7 11l5 5l5 -5" />
                        <path d="M12 4l0 12" />
                    </svg>
                </span>

                <span class="w-fit h-fit py-1.5 px-3 bg-blue-500 rounded-sm cursor-pointer hover:bg-blue-500/50 transition-all duration-100 ease-in text-white text-sm">
                    Share
                </span>

                <span class="w-fit h-fit py-1 px-3 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in text-white text-sm flex justify-center items-center gap-2">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-presentation h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M3 4l18 0" />
                        <path d="M4 4v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2 -2v-10" />
                        <path d="M12 16l0 4" />
                        <path d="M9 20l6 0" />
                        <path d="M8 12l3 -3l2 2l3 -3" />
                    </svg>
                    Present
                </span>
            </div>
        </div>

        <div class="relative w-full h-full flex">
            <div id="left-slide" class="absolute -left-[25rem] w-[25rem] h-full bg-[#383838] flex z-10 transition-all ease-in duration-300">
                <div class="flex flex-col gap-4 w-[5rem] h-full py-2 items-center bg-[#383838] border-r-2 border-[rgb(252,127,83)]">
                    <span id="menu-btn" data-section="section_templates" class="w-fit h-fit p-1 bg-[#FC7F53] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-[#ad4b1e]">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-spaces h-7 max-[980px]:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M6.045 9.777a6 6 0 1 0 5.951 .023" />
                            <path d="M11.997 20.196a6 6 0 1 0 -2.948 -5.97" />
                            <path d="M17.95 9.785q .05 -.386 .05 -.785a6 6 0 1 0 -3.056 5.23" />
                        </svg>
                    </span>

                    <span id="menu-btn" data-section="section_shapes" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-transparent">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-hexagons h-7 max-[980px]:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M4 18v-5l4 -2l4 2v5l-4 2z" />
                            <path d="M8 11v-5l4 -2l4 2v5" />
                            <path d="M12 13l4 -2l4 2v5l-4 2l-4 -2" />
                        </svg>
                    </span>

                    <span id="menu-btn" data-section="section_images" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-transparent">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-photo h-7 max-[980px]:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M15 8h.01" />
                            <path d="M3 6a3 3 0 0 1 3 -3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12z" />
                            <path d="M3 16l5 -5c.928 -.893 2.072 -.893 3 0l5 5" />
                            <path d="M14 14l1 -1c.928 -.893 2.072 -.893 3 0l3 3" />
                        </svg>
                    </span>

                    <span id="menu-btn" data-section="section_icons" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-transparent">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-file-vector h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M14 3v4a1 1 0 0 0 1 1h4" />
                            <path d="M9.5 16.5m-1.5 0a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0" />
                            <path d="M14.5 12.5m-1.5 0a1.5 1.5 0 1 0 3 0a1.5 1.5 0 1 0 -3 0" />
                            <path d="M17 21h-10a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2h7l5 5v11a2 2 0 0 1 -2 2z" />
                            <path d="M9.5 15a2.5 2.5 0 0 1 2.5 -2.5h1" />
                        </svg>
                    </span>

                    <span id="menu-btn" data-section="section_folders" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-transparent">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-folder-plus h-7 max-[980px]:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M12 19h-7a2 2 0 0 1 -2 -2v-11a2 2 0 0 1 2 -2h4l3 3h7a2 2 0 0 1 2 2v3.5" />
                            <path d="M16 19h6" />
                            <path d="M19 16v6" />
                        </svg>
                    </span>

                    <span id="menu-btn" data-section="section_plugins" class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in border-2 border-transparent">
                        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-category h-7 max-[980px]:h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M4 4h6v6h-6z" />
                            <path d="M14 4h6v6h-6z" />
                            <path d="M4 14h6v6h-6z" />
                            <path d="M17 17m-3 0a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" />
                        </svg>
                    </span>
                </div>

                <div class="w-full h-full bg-[#383838]">
                    <header class="w-full h-12 flex relative py-1 px-3 justify-start items-center mt-2">
                        <span class="absolute left-5">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-search h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
                                <path d="M21 21l-6 -6" />
                            </svg>
                        </span>
                        <input type="search" name="serch_shapes" id="search_shapes" placeholder="Search icons & graphics" class="w-full h-full bg-[#505050] rounded-[3px] pl-10 text-sm outline-none text-white">
                    </header>

                    <section id="section_options" class="w-full overflow-y-auto">
                        <SectionTemplates state="hidden" id="section_templates"/>
                        <SectionShapes state="flex" id="section_shapes"/>
                        <SectionImages state="hidden" id="section_images"/>
                        <SectionIcons state="hidden" id="section_icons"/>
                        <SectionFolders state="hidden" id="section_folders"/>
                        <SectionPlugins state="hidden" id="section_plugins"/>
                    </section>
                </div>

                <span id="close-left-slide" class="w-fit h-fit rounded-r-md cursor-pointer bg-[#505050] border-2 border-r-[#505050] border-t-[#505050] border-b-[#505050] border-l-transparent absolute left-[25rem] top-5">
                    <svg class="icon icon-tabler icons-tabler-outline icon-tabler-chevrons-right h-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                        <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                        <path d="M7 7l5 5l-5 5" />
                        <path d="M13 7l5 5l-5 5" />
                    </svg>
                </span>
            </div>

            <div id="content-konva" class="w-full h-full bg-lime-400">
                <div id="konva" class="bg-white w-full h-full"></div>
            </div>

            <div id="content-test" class="hidden">
                <div id="test" class="hidden"></div>
            </div>

            <div id="right-slide" class="absolute -right-[25rem] w-[25rem] h-full bg-[#383838] flex flex-col transition-all ease-in duration-300">
                <header class="w-full h-14 flex justify-center items-center gap-16">
                    <span class="text-[#FC7F53] text-md font-semibold cursor-pointer">
                        Design
                    </span>

                    <span class="w-[2px] h-1/2 bg-[#696969]"></span>

                    <span class="text-white text-md font-semibold cursor-pointer">
                        Slides
                    </span>
                </header>

                <section class="w-full h-full flex flex-col">

                    <div class="w-full h-fit py-4 px-3 flex justify-around items-center border-b-2 border-[#FC7F53]">
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-align-left h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M4 4l0 16" />
                                <path d="M8 9m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>

                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-align-center h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M12 4l0 5" />
                                <path d="M12 15l0 5" />
                                <path d="M6 9m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                        
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-align-right h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M20 4l0 16" />
                                <path d="M4 9m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                        
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-align-top h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M4 4l16 0" />
                                <path d="M9 8m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                        
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-align-bottom h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M4 20l16 0" />
                                <path d="M9 4m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                        
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-distribute-vertical h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M4 4l0 16" />
                                <path d="M20 4l0 16" />
                                <path d="M9 6m0 2a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-2a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                        
                        <span class="w-fit h-fit p-1 bg-[#595959] rounded-sm cursor-pointer hover:bg-[#595959]/50 transition-all duration-100 ease-in">
                            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-layout-distribute-horizontal h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                <path d="M4 4l16 0" />
                                <path d="M4 20l16 0" />
                                <path d="M6 9m0 2a2 2 0 0 1 2 -2h8a2 2 0 0 1 2 2v2a2 2 0 0 1 -2 2h-8a2 2 0 0 1 -2 -2z" />
                            </svg>
                        </span>
                    </div>

                    <div class="w-full h-fit py-5 px-5 border-b-2 border-[#FC7F53]">
                        <h3 class="text-white font-bold">
                            Layout
                        </h3>

                        <div class="w-full h-fit grid grid-cols-2 gap-y-2 gap-x-12 grid-rows-1 px-3 mt-2">
                            <div class="flex items-center justify-start">
                                <span class="text-white font-bold text-xs w-full">
                                    offset X
                                </span>
    
                                <input type="number" name="input_layout_x" id="input_layout_x" class="w-full h-full rounded-sm bg-[#585858] py-1.5 px-2 text-white text-xs font-bold outline-none">
                            </div>

                            <div class="flex items-center justify-start">
                                <span class="text-white font-bold text-xs w-full">
                                    offset Y
                                </span>
    
                                <input type="number" name="input_layout_x" id="input_layout_x" class="w-full h-full rounded-sm bg-[#585858] py-1.5 px-2 text-white text-xs font-bold outline-none">
                            </div>

                            <div class="flex items-center justify-start">
                                <span class="text-white font-bold text-xs w-full">
                                    Width
                                </span>
    
