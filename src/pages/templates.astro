---
import Layout from '../layouts/Layout.astro';
import Slide from '../components/Sections/SlideDesktop.astro';
import Content from '../components/Sections/Content.astro';
import Header from '../components/Sections/Header.astro';
import SlideMobile from '../components/Sections/SlideMobile.astro';
import FilterTemplates from '../components/Articles/FilterTemplates.astro';
import Filter from '../components/Articles/Filter.astro';
import SearchBar from '../components/Articles/SearchBar.astro';
import TemplateView from '../components/Articles/TemplateView.astro';
import Content from '../components/Sections/Content.astro';
import Slide from '../components/Sections/SlideDesktop.astro';
import SlideMobile from '../components/Sections/SlideMobile.astro';
import Layout from '../layouts/Layout.astro';

import { getAllTemplates } from '../js/backend/requests';

const reqTemplates = await getAllTemplates();
let templates;

let templateVoid = {
	name: "Plantilla Vacia",
	template_id: 0,
	preview: "../../../public/placeholder/image_preview.svg",
	description: "Plantilla Vacia.",
	autor: "Parcify",
	likes: null
}

if(!reqTemplates.state){
    templates = [templateVoid]
}else{
    templates = reqTemplates.data.message;
	templates = [templateVoid, ...templates];
}

const logged = Astro.cookies.get("logged")?.value;
const id = Astro.cookies.get("ID-USER")?.value;

if(logged != 'true' && !id){
  return Astro.redirect("/SignIn")
}

let get_data: any;
let data: any;

try{
	get_data = await fetch(`http://localhost:4000/user/data?id_user=${id}`);
	data = await get_data.json();
	data = data.message;

	if(data == "El Usuario no existe."){
		Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
		Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
		return Astro.redirect("/SignIn")
	}
}catch(e){
	Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
    Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	return Astro.redirect("/SignIn")
}

---

<Layout title="Parcify">
	<div class="w-full h-fit flex">
		<Slide/>
		<SlideMobile/>
		<Content>
			<article class="w-full">
				<div class="w-full flex max-[880px]:grid max-[880px]:grid-cols-1 max-[880px]:gap-3 justify-start items-center p-2 bg-[#383838] rounded-md shadow-lg shadow-[#181818] mb-4">
					<SearchBar section="templates" article='template' placeholder='Search Projects'></SearchBar>
					<div class="flex w-full h-fit items-center justify-between max-[880px]:pl-3">
						<FilterTemplates section='templates' article='template'/>
					</div>
				</div>

				<article class="w-full">
					<div id="content-grid-templates" data-section="templates" class="w-full grid grid-cols-3 max-xl:grid-cols-2 max-[980px]:grid-cols-1 gap-5 gap-y-10 overflow-hidden">
						{
							templates.length > 0 ? (
								templates.map((template: any) => (
									<TemplateView
									    id="template"
										first_text={template.name} 
										second_text={template.autor} 
										url_image={template.preview} 
										template_id={template.template_id} 
										description={template.description}
										likes={template.likes}
									/>
								))
							) : (
								<p>No templates available</p>
							)
						}
					</div>
					
				</article>
			</article>
		</Content>

	</div>
</Layout>