# Variables de deploy/compose.prod.yml. Genera deploy/.env con:
#   ./deploy/scripts/new-env.sh parcify.midominio.com tu@correo.com
# deploy/.env no se sube nunca al repositorio.

# ---------------------------------------------------------------------------
# Obligatorias
# ---------------------------------------------------------------------------

# Dominio de la web. De él salen los otros tres hosts, que necesitan su registro DNS:
#   https://DOMAIN (web), https://api.DOMAIN, https://collab.DOMAIN y https://s3.DOMAIN (S3 incluido).
DOMAIN=
# Correo para Let's Encrypt (avisos de caducidad de los certificados).
ACME_EMAIL=

# Contraseñas de Postgres y Redis (solo letras y números: van dentro de una URL).
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Secretos de al menos 32 caracteres, distintos entre sí.
BETTER_AUTH_SECRET=
COLLAB_TOKEN_SECRET=

# Correo real: resend o smtp (console no se admite en producción).
MAIL_DRIVER=resend
# Remitente; por defecto «Parcify <no-reply@DOMAIN>». Tiene que ser de un dominio verificado en tu proveedor.
MAIL_FROM=
# Con MAIL_DRIVER=resend.
RESEND_API_KEY=
# Con MAIL_DRIVER=smtp, p. ej. smtps://usuario:contraseña@smtp.proveedor.com:465 (caracteres especiales codificados).
SMTP_URL=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# S3 incluido (SeaweedFS en s3.DOMAIN): deja COMPOSE_PROFILES=s3 y S3_ENDPOINT vacío.
# Bucket externo (Cloudflare R2, AWS S3...): COMPOSE_PROFILES vacío, S3_ENDPOINT con su endpoint
#   (p. ej. https://<id de cuenta>.r2.cloudflarestorage.com), S3_REGION (auto en R2) y las credenciales de un token
#   limitado al bucket. El bucket tiene que ser privado y tener CORS GET, HEAD y PUT desde https://DOMAIN con la
#   cabecera content-type.
COMPOSE_PROFILES=s3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=parcify
# Con el S3 incluido, se generan aquí; con un bucket externo, las de tu proveedor.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------------------

# Google OAuth: las dos o ninguna. URI de redirección autorizada: https://api.DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# IA. Cada función elige su modelo con proveedor:modelo y el proveedor necesita su clave.
# Una función sin modelo queda desactivada y la interfaz oculta su botón. Ejemplos:
#   OPENAI_API_KEY=...            AI_MODEL_CHAT=openai:gpt-5.1           AI_MODEL_IMAGE=openai:gpt-image-1
#   ANTHROPIC_API_KEY=...         AI_MODEL_CHAT=anthropic:claude-sonnet-4-5 (no genera imágenes)
#   GOOGLE_GENERATIVE_AI_API_KEY= AI_MODEL_CHAT=google:gemini-2.5-flash  AI_MODEL_IMAGE=google:gemini-2.5-flash-image
#   API compatible con OpenAI (OpenRouter, Groq...): OPENAI_API_KEY de ese servicio, OPENAI_BASE_URL con su URL y
#   AI_MODEL_*=openai:<id del modelo allí>.
OPENAI_API_KEY=
# Solo para APIs compatibles con OpenAI; descoméntala con un valor (vacía impide arrancar la API).
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# Asistente del lienzo.
AI_MODEL_ASSISTANT=
# Animaciones.
AI_MODEL_ANIMATION=
# Chat de IA del proyecto.
AI_MODEL_CHAT=
# Generación de imágenes.
AI_MODEL_IMAGE=
# Describir imágenes adjuntas; por defecto, el del asistente.
AI_MODEL_VISION=
# Unidades al mes por espacio (2000) y al día por usuario (100).
AI_QUOTA_WORKSPACE_MONTHLY_UNITS=
AI_QUOTA_USER_DAILY_UNITS=
# Hosts desde los que se puede descargar una imagen si el proveedor devuelve una URL. Vacío = ninguno.
AI_IMAGE_DOWNLOAD_HOSTS=

# Observabilidad. METRICS_TOKEN de al menos 16 caracteres protege /metrics (sin él responde 401).
METRICS_TOKEN=
SENTRY_DSN=
# DSN de Sentry para el navegador; se incrusta al construir la web.
PUBLIC_SENTRY_DSN=
LOG_LEVEL=info

# Ajustes finos.
DATABASE_POOL_MAX=
COLLAB_MAX_CONN_PER_DOC=
