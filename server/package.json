{
  "name": "parcify-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/shared/SHARED_HASH','dist/shared/SHARED_HASH')\"",
    "typecheck": "prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:int": "vitest run -c vitest.int.config.ts",
    "shared:hash": "tsx scripts/shared-hash.ts",
    "stack:dev:up": "docker compose -f compose.dev.yml up -d --wait",
    "stack:dev:down": "docker compose -f compose.dev.yml down",
    "stack:test:up": "docker compose -f compose.test.yml up -d --wait",
    "stack:test:down": "docker compose -f compose.test.yml --profile s3 down -v",
    "start:e2e": "tsx scripts/dev.ts --e2e",
    "start:api": "node dist/api/main.js",
    "start:collab": "node dist/collab/main.js"
  },
  "overrides": {
    "yjs": "13.6.33"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.80",
    "@ai-sdk/google": "4.0.96",
    "@ai-sdk/openai": "4.0.94",
    "@aws-sdk/client-s3": "3.1152.0",
    "@aws-sdk/lib-storage": "3.1152.0",
    "@aws-sdk/s3-request-presigner": "3.1152.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.4",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/under-pressure": "9.2.1",
    "@hocuspocus/extension-database": "4.7.1",
    "@hocuspocus/extension-redis": "4.7.1",
    "@hocuspocus/server": "4.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@sentry/node": "11.8.0",
    "ai": "7.0.141",
    "better-auth": "1.7.10",
    "fastify": "5.12.7",
    "fastify-plugin": "6.0.1",
    "fastify-type-provider-zod": "7.0.0",
    "fflate": "0.8.3",
    "file-type": "22.2.0",
    "fractional-indexing": "4.0.0",
    "ioredis": "5.6.1",
    "jose": "6.2.12",
    "lib0": "0.2.119",
    "nanoid": "6.0.2",
    "nodemailer": "10.1.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "prisma": "7.10.0",
    "prom-client": "15.1.3",
    "resend": "6.33.0",
    "sharp": "0.35.5",
    "tldts": "7.4.18",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fastify/swagger": "9.9.2",
    "@hocuspocus/provider": "4.7.1",
    "@types/node": "26.6.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.5"
  }
}
