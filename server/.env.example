# Copia este archivo a .env y rellena los valores. Nunca subas .env al repositorio.

NODE_ENV=development
LOG_LEVEL=info

# Orígenes públicos. Cliente, API y colaboración deben compartir dominio registrable.
API_ORIGIN=http://localhost:3000
COLLAB_ORIGIN=http://localhost:3001
CLIENT_ORIGINS=http://localhost:4321

# En desarrollo scripts/dev.ts fija 3000 para api y 3001 para collab.
PORT=3000
INSTANCE_ID=
TRUST_PROXY_HOPS=0

# Stack de compose.dev.yml (credenciales solo locales).
DATABASE_URL=postgresql://parcify:parcify_dev@127.0.0.1:55432/parcify
DATABASE_POOL_MAX=
REDIS_URL=redis://:parcify_dev@127.0.0.1:56379/0
# Solo para `prisma migrate diff --from-migrations` (base de datos vacía de usar y tirar).
SHADOW_DATABASE_URL=postgresql://parcify:parcify_dev@127.0.0.1:55432/parcify_shadow

# Secretos de al menos 32 caracteres, distintos entre sí (p. ej. openssl rand -base64 48).
BETTER_AUTH_SECRET=
COLLAB_TOKEN_SECRET=

# Google OAuth (opcional; sin ellas el botón de Google no aparece).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Correo: smtp | resend | console (console solo fuera de producción) | memory (solo NODE_ENV=test).
MAIL_DRIVER=console
MAIL_FROM=Parcify <no-reply@example.com>
SMTP_URL=
RESEND_API_KEY=

# Storage: s3 | local.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=
STORAGE_URL_SECRET=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=

# IA (todo opcional). Cada función elige su modelo con proveedor:modelo y el proveedor necesita su clave.
# Una función sin modelo queda desactivada (GET /v1/meta la marca como false y la UI oculta su botón).
# Cambiar de proveedor es cambiar la clave y el AI_MODEL_* correspondiente, y reiniciar la API.
#   OpenAI:        OPENAI_API_KEY=sk-...           AI_MODEL_CHAT=openai:gpt-5.1      AI_MODEL_IMAGE=openai:gpt-image-1
#   Anthropic:     ANTHROPIC_API_KEY=sk-ant-...    AI_MODEL_CHAT=anthropic:claude-sonnet-4-5   (no genera imágenes)
#   Google Gemini: GOOGLE_GENERATIVE_AI_API_KEY=... AI_MODEL_CHAT=google:gemini-2.5-flash   AI_MODEL_IMAGE=google:gemini-2.5-flash-image
#   Otros con API compatible con OpenAI (OpenRouter, Groq, Ollama, LM Studio...): OPENAI_API_KEY con la clave de ese
#   servicio, OPENAI_BASE_URL con su URL (p. ej. https://openrouter.ai/api/v1) y AI_MODEL_*=openai:<id del modelo allí>.
# Se pueden mezclar: p. ej. el chat con anthropic:... y las imágenes con openai:...
OPENAI_API_KEY=
OPENAI_BASE_URL=
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Asistente del lienzo (salida estructurada).
AI_MODEL_ASSISTANT=
# Animaciones (salida estructurada).
AI_MODEL_ANIMATION=
# Chat de IA del proyecto (streaming).
AI_MODEL_CHAT=
# Generación de imágenes (modelo de imagen).
AI_MODEL_IMAGE=
# Opcional: describe las imágenes adjuntas si el modelo del asistente no las acepta. Por defecto, el del asistente.
AI_MODEL_VISION=
# Cuotas por defecto: unidades al mes por espacio (2000) y al día por usuario (100). Cada espacio puede tener las
# suyas en la tabla WorkspaceAiQuota. Unidades: asistente, animación y mensaje de chat = 1; cada imagen = 4.
AI_QUOTA_WORKSPACE_MONTHLY_UNITS=
AI_QUOTA_USER_DAILY_UNITS=
# Hosts (separados por comas) desde los que se puede descargar una imagen si un proveedor devuelve una URL en vez de
# los bytes. Vacío = ninguna descarga.
AI_IMAGE_DOWNLOAD_HOSTS=

# Colaboración.
COLLAB_MAX_CONN_PER_DOC=

# Observabilidad.
METRICS_TOKEN=
SENTRY_DSN=
