---
import * as globals from '../../js/frontend/utilities/globals'

interface Props{
  id?: string,
  id_project?: string,
  id_element?: string,
  name: string,
  last_modified: string,
  project_id: string,
  preview: string,
}

//Data variables
const { id, id_project, id_element, name, last_modified, project_id, preview} = Astro.props;


---

<div class=`w-full max-w-xl h-fit relative ${id}` data-name={name} data-modified={last_modified}>
  <div id=`${id_project || "element-project"}` data-id={project_id} data-id-element={id_element} class="bg-transparent border-2 border-transparent hover:border-[#1E90FF]/70 hover:bg-[#1E90FF]/30 mb-2 absolute cursor-pointer w-full h-72 z-10"></div>

  <div class="bg-[#f5f5f5] relative cursor-pointer w-full h-72">
    {
      preview ? (
        <img src={preview} class="w-full h-full"/>
      ) : (
        <img src="../../../placeholder/image_preview.svg" class="w-full h-full"/>
      )
    }
  </div>

  <div class="flex justify-between w-full items-center p-2 bg-[#1f1f1f] rounded-b-md">
    <div class="flex flex-col w-full gap-y-1">
      <div class="w-full flex gap-x-2">
        {globals.isNewProject(last_modified) && (
          <span class="bg-[#1E90FF] p-1 rounded-md text-sm">
            Nuevo
          </span>
        )}
        <h3 class="name-of-parcel text-white pb-1 text-xl font-bold max-xl:text-lg truncate w-full">{name}</h3>
        <input type="text" value={name} class="input-of-parcel bg-transparent hidden text-white outline-none pb-1 border-b-2 border-[#383838] hover:border-[#1E90FF] ease duration-150 text-xl font-bold max-xl:text-lg truncate w-full">
      </div>

      <h4 class="text-gray-300 text-lg max-xl:text-base">Editado hace {globals.lastModified([last_modified])}</h4>
    </div>
  </div>

  <div id="selectionIdentifier" class="hidden border-[3px] border-[#1E90FF]/70 bg-transparent mb-2 absolute top-0 cursor-pointer w-full h-72 z-9"></div>
</div>
