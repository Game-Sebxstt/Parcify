---
import { formatNumber } from '../../js/frontend/utilities/globals';

interface Props{
  id:string,
  first_text: string;
  second_text: string;
  url_image: string,
  template_id: string,
  description: string,
  likes: string,
}

const {id, first_text, second_text, url_image, template_id, description, likes} = Astro.props;
let formatLikes

if(likes){
  formatLikes = formatNumber(JSON.parse(likes).length || 0);
}

---

<div id={id} data-id={template_id} data-name={first_text} data-preview={url_image} data-author={second_text} data-description={description} data-likes={likes} class="create-template template w-full h-fit cursor-pointer">
    <div class="w-full h-72 relative">
        {
          url_image != "../../../placeholder/image_preview.svg" ? (
            <div class="w-full h-full absolute top-0 left-0">
              <img src={url_image} class="w-full h-full">
            </div>
          ) : (
            <div class="bg-[#E6E6E6] w-full h-full absolute top-0 left-0">
              <img src={url_image} class="w-full h-full">
            </div>
          )
        }

      <div class="w-full h-full flex justify-center items-center mb-2 border-2 border-transparent cursor-pointer transition-all duration-[500] ease-in hover:border-[#1E90FF] hover:bg-[#1E90FF]/70 [&>svg]:hover:opacity-100 absolute top-0 left-0">
        <svg class="icon icon-tabler icons-tabler-outline icon-tabler-plus w-12 opacity-0 transition-all duration-[500] ease-in" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
          <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
          <path d="M12 5l0 14" />
          <path d="M5 12l14 0" />
        </svg>
      </div>
    </div>
  
    <div class="flex justify-start gap-5 items-center relative p-2 bg-[#1E1E1E] rounded-b-md">  
      <img src="../../../Logo-no-background-no-text.png" class="h-12 max-xl:h-10">

      <div class="w-full h-full flex justify-between pr-2">
        <div class="flex flex-col">
          <h3 class="text-white text-xl font-bold max-xl:text-lg">{first_text}</h3>
          <h4 class="text-gray-300 text-lg max-xl:text-base">{second_text}</h4>
        </div>

        {
          formatLikes === null ? (
            <span></span>
          ) : (
            <div class="flex items-center gap-1 justify-between">
              <h3 class="text-white text-sm font-bold max-xl:text-sm">{formatLikes}</h3>
              <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="#ffffff" ><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M6.979 3.074a6 6 0 0 1 4.988 1.425l.037 .033l.034 -.03a6 6 0 0 1 4.733 -1.44l.246 .036a6 6 0 0 1 3.364 10.008l-.18 .185l-.048 .041l-7.45 7.379a1 1 0 0 1 -1.313 .082l-.094 -.082l-7.493 -7.422a6 6 0 0 1 3.176 -10.215z" /></svg>
            </div>
          )
        }
        
      </div>
    </div> 
</div>
