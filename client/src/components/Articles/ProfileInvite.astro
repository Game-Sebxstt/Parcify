---
interface Props{
    letter: string;
    color: string;
    id_user?: string;
}

const {letter, color, id_user} = Astro.props;
console.log(color);
---

<div id="profile-invite" style=`background: ${color};` data-id-user={id_user} class=`w-8 h-8 rounded-full flex justify-center items-center text-center text-white font-lighter text-base cursor-pointer text-xs bg-[${color}]`>
    {letter.toUpperCase()}
</div>