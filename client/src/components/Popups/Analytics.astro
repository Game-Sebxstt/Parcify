---
import Metric from '../Articles/Metric.astro';
import Performance from '../Articles/Performance.astro';
import Summary from '../Articles/Summary.astro';
import Working from '../Articles/Working.astro';

interface Props{
    id_content: string,
}

const {id_content} = Astro.props;
---

<div id={id_content} data-id="0" class="content-all fixed z-50 hidden animate-deployment justify-center items-center w-full h-full px-3">
   
    <div id="close-bg" class="w-full h-full absolute top-0 left-0 cursor-pointer bg-black/80 z-0"></div>

    <div class="bg-[#2c2c2c] w-full max-w-6xl h-[95%] shadow-gray-900 rounded-lg z-10 flex flex-col">
        <header class="px-5 py-3 border-b border-[#1E90FF] flex flex-row items-center justify-between">

            <h1 class="text-2xl font-bold">
                Project Dashboard
            </h1>

            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
      </header>

        <section class="w-full h-full px-3 py-3 overflow-y-scroll overflow-x-hidden grid grid-cols-2 gap-x-4 max-[820px]:grid-cols-1 max-[820px]:gap-y-4 gap-y-4">
            <Metric metric='Commit Activity' id_graphic='commits' type='bar'/>
            <Metric metric='Total Time Worked' id_graphic='time_worked' type='line'/>
            <Performance/>
            <Working/>
            <Summary/>
        </section>
    </div>
 </div>

<script>

let cls_bg = document.querySelectorAll("#close-bg") as NodeListOf<HTMLButtonElement>;

cls_bg.forEach(item =>  {
    item.addEventListener ('click', () => {
        (item.parentNode as HTMLElement).style.display = "none";
    });
})

let cls_btn = document.querySelectorAll("#close-button") as NodeListOf<HTMLButtonElement>;

cls_btn.forEach(item =>  {
    item.addEventListener ('click', () => {
        (item.parentNode?.parentNode?.parentNode as HTMLElement).style.display = "none";
    });
})
</script>

    
