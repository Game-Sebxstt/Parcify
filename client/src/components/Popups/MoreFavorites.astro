---
import TemplateView from "../Articles/TemplateView.astro";
import Article from "../Articles/Article.astro";
import { getDataUser, getFavorites } from "../../js/backend/requests";
import * as globals from '../../js/frontend/utilities/globals'

const id = Astro.cookies.get("ID-USER")?.value;

const data_response = await getDataUser(id);
let elementsUser: any;
let elementsFiltered: any = [];

if(data_response.state){
    elementsUser = [...data_response.data.message.templates, ...data_response.data.message.projects]
    let favorites: any = await getFavorites(id);

    if(favorites.state){
        favorites = JSON.parse(favorites.data.message[0].templates || "[]");

        favorites.forEach((favorite: any) => {
            elementsUser.forEach((element: any) => {
                if(element.template_id == favorite.id || element.project_id == favorite.id){
                    elementsFiltered.push(element);
                }
            })
        });
    }

    elementsUser = elementsFiltered;
}
---

<section id="moreFavorites" class="fixed w-full h-full z-40 hidden justify-center items-center bg-black/80">
    <section class="max-w-[72rem] h-[95%] bg-[#2c2c2c] rounded-md p-3 flex flex-col gap-2 animate-deployment">
        <header class="flex items-center justify-between">
            <div class="flex items-center gap-1">
                <img src="/Logo-no-background-no-text.png" class="h-10"/>
                <h3 class="text-xl font-bold text-white">Parcify</h3>
            </div>
            <button id="close-button" type="button" class="text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                </svg>
            </button>
        </header>
        <hr class="border-blue-500">

        <main id="content-more-favorites" class="h-full p-2 grid grid-cols-2 gap-5 overflow-auto">
            {
                data_response.state && elementsUser ? (
                    elementsUser.map((element: any) => (
                        element.template_id ? (
                            <TemplateView 
                                id="templateFavorites" 
                                first_text={element.name} 
                                second_text={element.autor} 
                                url_image={element.preview}
                                template_id={element.template_id}
                                description={element.description}
                                likes={element.likes}
                            />
                        ) : (
                            <Article 
                                id="project"
                                id_element={globals.generateID()}
                                name={element.name} 
                                last_modified={element.last_modified}
                                project_id={element.project_id}
                                preview={element.preview}
                            />
                        )
                    ))
                ) : (
                    <span>
                        Dont have any favorite
                    </span>
                )
            }
        </main>
    </section>
</section>