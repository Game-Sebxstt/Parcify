---
import ProfileInvite from "../Articles/ProfileInvite.astro";

interface Props{
    message?: string
    id: string,
    type: string,
}

const { message, id, type } = Astro.props;
---

<div id={id} data-type={type} data-id="0" class="w-full h-fit p-1.5 flex flex-col gap-y-2 mb-2">
    <header class="w-full h-fit flex flex-row-reverse gap-x-2 justify-start items-center">
        <ProfileInvite color="bg-green-500" letter="A"/>

        <span id="user" class="font-bold">
            Tu
        </span>
    </header>

    <article class="w-full h-fit relative flex justify-end">
        <div id="info-message" class="w-full max-w-[85%] h-fit bg-[#313131] p-1 relative rounded-md">
            <div id="response-message" data-id-response="0" class="bg-slate-600 w-full h-full flex overflow-hidden rounded-[3px]">
                <span class="bg-blue-400 w-4"></span>

                <p id="user-response" class="text-white text-[10px] font-bold w-full h-full absolute left-1.5 translate-x-5">
                    Sebxstt
                </p>

                <p id="message-response" class="text-white text-sm w-full h-fit truncate px-2 pt-4 pb-1">
                    Lorem ipsum dolor sit amet consectetur, adipisicing elit. Ratione, quo. Molestiae inventore similique quisquam totam
                </p>
            </div>

            <p id="message" class="text-white text-sm w-full h-full p-1 pb-6 break-words">
                {message}
            </p>

            <span id="date" class="text-xs absolute -translate-y-full right-3">
                12:00 P.M
            </span>

            <button id="resend" class="w-fit h-fit absolute top-1/2 -translate-y-1/2 -translate-x-full outline-none">
                <svg class="icon icon-tabler icons-tabler-outline icon-tabler-corner-down-left-double h-8 w-8" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M19 5v6a3 3 0 0 1 -3 3h-7" />
                    <path d="M13 10l-4 4l4 4m-5 -8l-4 4l4 4" />
                </svg>
            </button>
        </div>
    </article>
</div>

<style>
    #date{
        top: calc(100% - 5px)
    }

    #resend{
        left: calc(-16px)
    }
</style>