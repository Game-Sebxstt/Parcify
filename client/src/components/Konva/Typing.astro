---
import ProfileInvite from "../Articles/ProfileInvite.astro";

interface Props{
    collaborator: any
}

const { collaborator } = Astro.props;
---

<div id="typing-chat" data-id-user={collaborator.user_id} class="w-full h-fit p-1.5 hidden flex-col gap-y-2 mb-2">
    <header class="w-full h-fit flex flex-row gap-x-2 justify-start items-center">
        <ProfileInvite 
            color={`${collaborator.color ? collaborator.color.hex : "red"} -ml-2`}
            letter={collaborator.name[0]}
        />

        <div class="flex relative w-1/2">
            <span class="text-white font-bold">
                {collaborator.name}
            </span>

            <span class="text-white absolute translate-y-full w-full text-sm mt-1">
                Esta escribiendo...
            </span>
        </div>
    </header>
</div>

<style>
    #date{
        top: calc(100% - 5px)
    }

    #resend{
        left: calc(-16px)
    }
</style>