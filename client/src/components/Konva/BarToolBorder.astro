---

---

<div id="BarToolExtra" data-type="border" class="absolute -top-5 left-0 -translate-y-full z-[5] pr-2 w-fit h-20 rounded-lg bg-[#313131] border-[rgba(255,255,255,.2)] border-[1px] hidden opacity-100 justify-start items-center">
    <div id="nameBar" class="flex justify-center items-center h-full w-full gap-x-2 px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md cursor-pointer">
        <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" id="chevron" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left w-6 h-6">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M15 6l-6 6l6 6" />
        </svg>

        <span id="name" class="text-white text-base">Border</span>
    </div>

    <span class="w-0.5 h-[70%] mx-2 rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_color" class="childBarTool w-fit h-full flex justify-center items-center p-2 gap-x-2">
        <button id="input_border" data-border="normal" class="w-7 h-7 bg-[rgba(30,30,30,.9)] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg class="svg w-full h-full" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
                <path fill="#fafafa" fill-opacity="1" fill-rule="evenodd" stroke="white" d="m13 27 .707.707L27.85 13.565l-.707-.707L13 27z"></path>
            </svg>
        </button>

        <button id="input_border" data-border="dash" class="w-7 h-7 bg-[rgba(30,30,30,.9)] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg class="svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
                <path fill="#fafafa" fill-opacity="1" fill-rule="evenodd" stroke="white" d="m21.914 18.161-3.536 3.536.708.707 3.535-3.536-.707-.707zm2.828-1.414 2.829-2.829.707-.707-.707-.707-.707.707-2.829 2.829.707.707zm-11.313 9.9 2.828-2.829.707.707-2.828 2.829-.707.707-.707-.707.707-.708z"></path>
            </svg>
        </button>

        <button id="input_border" data-border="none" class="w-7 h-7 bg-[#FB7F53] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg class="svg" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 40 40">
                <path fill="#fafafa" fill-opacity="1" fill-rule="evenodd" stroke="white" d="M27 20c0 3.866-3.134 7-7 7-1.753 0-3.356-.644-4.584-1.71l9.875-9.874C26.356 16.644 27 18.247 27 20zm-12.29 4.584 9.874-9.875C23.356 13.644 21.753 13 20 13c-3.866 0-7 3.134-7 7 0 1.753.644 3.356 1.71 4.584zM28 20c0 4.418-3.582 8-8 8-4.418 0-8-3.582-8-8 0-4.418 3.582-8 8-8 4.418 0 8 3.582 8 8z"></path>
            </svg>
        </button>
    </div>
</div>

<script>
    const BarTool = document.getElementById("BarToolExtra") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });
</script>
