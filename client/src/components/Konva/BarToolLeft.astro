---

---

<div class="absolute bottom-0 left-0 -translate-y-full z-[10] w-full h-16 border-t-[1px] border-[rgba(255,255,255,.2)] bg-[#1E1E1E] px-2 py-3 flex items-center gap-3">
    <div class="w-fit h-fit flex gap-4">
        <button id="shape" data-select="square" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-square h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M3 3m0 2a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2z" />
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Square</span>
        </button>

        <button id="shape" data-select="circle" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-circle h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M12 12m-9 0a9 9 0 1 0 18 0a9 9 0 1 0 -18 0" />
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Circle</span>
        </button>

        <button id="shape" data-select="triangle" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-triangle h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M10.363 3.591l-8.106 13.534a1.914 1.914 0 0 0 1.636 2.871h16.214a1.914 1.914 0 0 0 1.636 -2.87l-8.106 -13.536a1.914 1.914 0 0 0 -3.274 0z" />
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Triangle</span>
        </button>

        <button id="shape" data-select="diamond" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-diamonds h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M10.831 20.413l-5.375 -6.91c-.608 -.783 -.608 -2.223 0 -3l5.375 -6.911a1.457 1.457 0 0 1 2.338 0l5.375 6.91c.608 .783 .608 2.223 0 3l-5.375 6.911a1.457 1.457 0 0 1 -2.338 0z" />
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Diamond</span>
        </button>
    </div>

    <span class="w-0.5 h-[70%] bg-[rgba(255,255,255,.2)] rounded-full"></span>

    <div class="w-fit h-fit flex gap-4">
        <button id="shape" data-select="text" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="lucide lucide-type h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4 7 4 4 20 4 20 7"/>
                <line x1="9" x2="15" y1="20" y2="20"/>
                <line x1="12" x2="12" y1="4" y2="20"/>
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Text</span>
        </button>
        
        <button id="shape" date-select="arrow" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="lucide lucide-move-right h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 8L22 12L18 16"/>
                <path d="M2 12H22"/>
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Move Right</span>
        </button>

        
        <button class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="lucide lucide-shapes h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M8.3 10a.7.7 0 0 1-.626-1.079L11.4 3a.7.7 0 0 1 1.198-.043L16.3 8.9a.7.7 0 0 1-.572 1.1Z"/>
                <rect x="3" y="14" width="7" height="7" rx="1"/>
                <circle cx="17.5" cy="17.5" r="3.5"/>
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Shapes</span>
        </button>
    </div>

    <span class="w-0.5 h-[70%] bg-[rgba(255,255,255,.2)] rounded-full"></span>

    <div class="w-fit h-fit flex gap-4">
        <button id="message-action" class="p-2 rounded-md bg-[#1E1E1E] hover:bg-[#383838] ease relative group">
            <svg class="lucide lucide-message-circle h-7" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/>
            </svg>
            <span class="absolute left-1/2 -translate-x-1/2 -top-5 -translate-y-full w-fit mb-2 text-white bg-black text-sm rounded px-2 py-1 opacity-0 group-hover:opacity-100 transition-opacity">Messages</span>
        </button>
    </div>
</div>
