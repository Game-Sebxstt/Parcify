---
import BarToolAlign from "./BarToolAlign.astro";
import BarToolBorder from "./BarToolBorder.astro";
import BarToolColor from "./BarToolColor.astro";
import BarToolColorText from "./BarToolColorText.astro";
import PickCustom from "./PickCustom.astro";
---

<div class="absolute top-28 left-28 z-5 w-fit h-fit p-2 py-3 rounded-2xl bg-[#313131] flex justify-center items-center gap-x-2">
    <span class="w-fit h-fit rounded-xl border-[1px] px-2 py-3">
        <button class="w-fit h-fit flex justify-center items-center gap-x-1">
            <i class="w-6 h-6 rounded-md bg-yellow-400"></i>
    
            <svg class="lucide lucide-chevron-down w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"/>
            </svg>
        </button>
    </span>

    <span class="w-fit h-fit flex gap-x-2 rounded-xl p-1 border-[1px]">
        <button class="w-fit h-fit flex justify-center items-center gap-x-1 hover:bg-slate-500 p-2 rounded-md">
            <svg class="lucide lucide-bold w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 12h9a4 4 0 0 1 0 8H7a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1h7a4 4 0 0 1 0 8"/>
            </svg>
        </button>

        <button class="w-fit h-fit flex justify-center items-center gap-x-1 hover:bg-slate-500 p-2 rounded-md">
            <svg class="lucide lucide-italic w-6 h-6" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" x2="10" y1="4" y2="4"/>
                <line x1="14" x2="5" y1="20" y2="20"/>
                <line x1="15" x2="9" y1="4" y2="20"/>
            </svg>
        </button>

        <button class="w-fit h-fit flex justify-center items-center gap-x-1 hover:bg-slate-500 p-2 rounded-md">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-strikethrough w-6 h-6"  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M5 12l14 0" />
                <path d="M16 6.5a4 2 0 0 0 -4 -1.5h-1a3.5 3.5 0 0 0 0 7h2a3.5 3.5 0 0 1 0 7h-1.5a4 2 0 0 1 -4 -1.5" />
            </svg>
        </button>

    </span>

    <BarToolColor/>
    <BarToolBorder/>
    <BarToolAlign/>
    <BarToolColorText/>
    <PickCustom/>
</div>

<script>
    import * as konva from "../../konva/js/KonvaLogic";
    import * as websocket from '../../js/backend/websocket'
    import * as GlobalFunctions from "../../konva/js/GlobalFunctions";
    import { setColor } from "../../konva/js/PickerCustom";

    const BarTool = document.getElementById("BarTool") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });

    const toolBarButton = document.querySelectorAll("#tool_bar_button") as NodeListOf<HTMLElement>
    let elementUpdate: HTMLElement | null = null;
    let keyUpdate: string | null = null;

    toolBarButton.forEach((element: HTMLElement) => {
        element.addEventListener("click", () => {
            GlobalFunctions.setUpdateToolBar(false)
            const dataTypeButton = element ? element.getAttribute("data-type") : "default";
            (document.querySelectorAll("#BarToolExtra") as NodeListOf<HTMLElement>).forEach((item: HTMLElement) => {
                const dataTypeItem = item.getAttribute("data-type")

                if (dataTypeButton === dataTypeItem) {
                    elementUpdate = item;
                    keyUpdate = dataTypeItem;
                } else {
                    item.classList.remove("flex")
                    item.classList.add("hidden")
                }
            })

            if (elementUpdate) {
                elementUpdate.classList.remove("hidden")
                elementUpdate.classList.add("flex")
                const dimensionBarToolExtra = konva.getDimensionBarToolExtra(keyUpdate)
                if(dimensionBarToolExtra.width == 0 && dimensionBarToolExtra.height == 0){
                    const dimensionNew = {
                        width: elementUpdate.offsetWidth,
                        height: elementUpdate.offsetHeight,
                    }
                    konva.setDimensionBarToolExtra(dimensionNew, keyUpdate)
                }

                GlobalFunctions.setUpdateToolBar(true)
            }
        });
    });

    const toolBarButtonAction = document.querySelectorAll("#tool_bar_button_action") as NodeListOf<HTMLElement>

    toolBarButtonAction.forEach((item: HTMLElement) => {
        item.addEventListener("click", () => {
            const dataTypeButton = item ? item.getAttribute("data-type") : "default";
            const dataValueButton = item ? item.getAttribute("data-value") : "default";

            var selection: any = window.getSelection();
            var selectedText: any = selection.toString();

            if (selectedText.length > 0) {
                document.execCommand(dataValueButton as string);
            }else{
                GlobalFunctions.actionToolBar(dataValueButton, dataTypeButton, true)
            }

            item.style.backgroundColor = window.getComputedStyle(item).backgroundColor === "rgb(251, 127, 83)" ? "transparent" : "rgb(251, 127, 83)";

            toolBarButtonAction.forEach((element: HTMLElement) => {
                const dataTypeElement = element ? element.getAttribute("data-type") : "default";

                if (element !== item && dataTypeButton == dataTypeElement) {
                    element.style.backgroundColor = "transparent";
                }
            })
        })
    })
    
    const toolBarFontFamily = document.querySelector("#BarToolFontFamily") as HTMLSelectElement;

    toolBarFontFamily.addEventListener("change", () => {
        GlobalFunctions.actionToolBar(toolBarFontFamily.value, "fontFamily", true)
    })

    const toolBarFontSize = document.querySelector("#BarToolFontSize") as HTMLInputElement;

    toolBarFontSize.addEventListener("change", () => {
        GlobalFunctions.actionToolBar(toolBarFontSize.value, "fontSize", true)
    })

    const BarToolExtraList = document.querySelectorAll("#BarToolExtra") as NodeListOf<HTMLElement>
        
    BarToolExtraList.forEach((item: HTMLElement) => {
        const dataTypeItem = item.getAttribute("data-type")
        const nameBar = item.querySelector("#nameBar") as HTMLElement;

        nameBar.addEventListener("click", () => {
            item.classList.remove("flex");
            item.classList.add("hidden");
            (document.querySelector("#konvaPickCustom") as HTMLElement).style.display = "none";
        })

        const styleColor = item.querySelector("#style_color") as HTMLElement;
        const inputColor = styleColor.querySelectorAll(`#input_${dataTypeItem}`) as NodeListOf<HTMLElement>;

        inputColor.forEach((element: HTMLElement) => {
            element.addEventListener("click", () => {

                const newDataTypeItem = dataTypeItem == "color" ? "fill" : dataTypeItem;

                const dataFill = element.getAttribute(`data-${newDataTypeItem}`) as string;
                let isCustomColor = true;

                if(dataFill != "custom"){
                    GlobalFunctions.actionToolBar(dataFill, newDataTypeItem, true)
                    setColor(dataFill)

                    if(dataTypeItem == "color"){
                        element.style.borderColor = "rgba(251, 127, 83)";
                        isCustomColor = false;

                        inputColor.forEach((item: HTMLElement) => {
                            if(element !== item){
                                item.style.borderColor = "transparent";
                            }
                        })
                    }else{
                        element.style.backgroundColor = window.getComputedStyle(element).backgroundColor === "rgb(251, 127, 83)" ? "rgba(30,30,30,.9)" : "rgb(251, 127, 83)";
                        isCustomColor = false;

                        inputColor.forEach((item: HTMLElement) => {
                            if(element !== item){
                                item.style.backgroundColor = "rgba(30,30,30,.9)";
                            }
                        })
                    }
                }

                if(isCustomColor){
                    (document.querySelector("#konvaPickCustom") as HTMLElement).style.display = window.getComputedStyle(document.querySelector("#konvaPickCustom") as HTMLElement).display == "none" ? "flex" : "none";
                }
            })
        })
    })
</script>
