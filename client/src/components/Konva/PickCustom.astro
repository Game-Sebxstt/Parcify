<div id="konvaPickCustom" data-type="align" class="absolute pointer-events-auto -top-[75px] left-0 hidden flex-col gap-y-2 p-2 -translate-y-full w-fit h-fit rounded-lg bg-[#313131] border-[rgba(255,255,255,.2)] border-[1px] opacity-100 justify-start items-center">
    <div id="picker"></div>
    <input type="text" id="colorInput" placeholder="Enter color (hex or rgb)" class="w-fit p-2 text-center bg-gray-100 border-2 border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition duration-200 shadow-md text-gray-700">
</div>

<script>

    const element_disabled = document.getElementById("konvaPickCustom") as HTMLDivElement;

    let wheelTimeout: string | number | NodeJS.Timeout | undefined;

    element_disabled.addEventListener("wheel", (event: any) => {
        event.preventDefault();

        console.log("wheel:", element_disabled);
        element_disabled.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            element_disabled.style.pointerEvents = "auto";
        }, 150);
    });
</script>
