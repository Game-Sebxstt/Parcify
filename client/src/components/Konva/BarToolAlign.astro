---

---

<div id="BarToolExtra" data-type="align" class="absolute -top-5 left-0 -translate-y-full z-[5] pr-2 w-fit h-20 rounded-lg bg-[#313131] border-[rgba(255,255,255,.2)] border-[1px] hidden opacity-100 justify-start items-center">
    <div id="nameBar" class="flex justify-center items-center h-full w-full gap-x-2 px-2 hover:bg-[rgba(30,30,30,.9)] rounded-md cursor-pointer">
        <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round" id="chevron" class="icon icon-tabler icons-tabler-outline icon-tabler-chevron-left w-6 h-6">
            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
            <path d="M15 6l-6 6l6 6" />
        </svg>

        <span id="name" class="text-white text-base">Align</span>
    </div>

    <span class="w-0.5 h-[70%] mx-2 rounded-full bg-[rgba(255,255,255,.3)]"></span>

    <div id="style_color" class="childBarTool w-fit h-full flex justify-center items-center p-2 gap-x-2">
        <button id="input_align" data-align="left" class="w-7 h-7 flex justify-center items-center bg-[rgba(30,30,30,.9)] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-align-left w-5 h-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M4 12l10 0" />
                <path d="M4 18l14 0" />
            </svg>
        </button>
        
        <button id="input_align" data-align="center" class="w-7 h-7 flex justify-center items-center bg-[#FB7F53] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg class="icon icon-tabler icons-tabler-outline icon-tabler-align-center w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M8 12l8 0" />
                <path d="M6 18l12 0" />
            </svg>
        </button>
        
        <button id="input_align" data-align="right" class="w-7 h-7 flex justify-center items-center bg-[rgba(30,30,30,.9)] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-align-right w-5 h-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M10 12l10 0" />
                <path d="M6 18l14 0" />
            </svg>
        </button>
        
        <button id="input_align" data-align="justify" class="w-7 h-7 flex justify-center items-center bg-[rgba(30,30,30,.9)] hover:opacity-80 transition-all duration-150 ease-in rounded-md">
            <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-align-justified w-5 h-5">
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M4 6l16 0" />
                <path d="M4 12l16 0" />
                <path d="M4 18l12 0" />
            </svg>
        </button>


    </div>
</div>

<script>
    const BarTool = document.getElementById("BarToolExtra") as HTMLDivElement;
    let wheelTimeout: NodeJS.Timeout;

    BarTool.addEventListener("wheel", (e) => {
        BarTool.style.pointerEvents = "none";

        if (wheelTimeout) {
            clearTimeout(wheelTimeout);
        }

        wheelTimeout = setTimeout(() => {
            BarTool.style.pointerEvents = "auto";
        }, 150)
    });
</script>
