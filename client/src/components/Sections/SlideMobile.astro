---
import Favorites from "../React/components/Favorites"
---
<div id="slideMobile" class="fixed top-16 z-[12] w-full -left-full transition-[left] duration-300 0 ease-in border-r-[1px] max-md:flex border-slate-500 h-screen bg-[#2b2929] hidden flex-col justify-between">
    <header class="flex flex-col">
        <div class="flex justify-between items-center w-full py-2 px-7">
            <div id="logo-header-slide" class="flex gap-3 justify-center items-center cursor-pointer" data-action="/">
                <img src="/Logo-no-background-no-text.png" class="h-12"/>
    
                <h3 class="text-xl font-bold text-white">Parcify</h3>
            </div>
        </div>
    </header>
    
    <section class="flex flex-col overflow-y-auto h-full justify-start">
        <article class="flex flex-col px-7 py-3 gap-3 justify-center">
            <div id="items-slide" data-uri="/" class="flex gap-3 items-center justify-start w-full hover:bg-[rgb(30,144,255)] transition-all duration-150 ease-in cursor-pointer px-2 py-2 rounded-sm">
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-home h-6">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M5 12l-2 0l9 -9l9 9l-2 0" />
                    <path d="M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2 -2v-7" />
                    <path d="M9 21v-6a2 2 0 0 1 2 -2h2a2 2 0 0 1 2 2v6" />
                </svg>
    
                <h3 class="text-lg text-white">Home</h3>
            </div>
    
            <div id="items-slide" data-uri="/templates" class="flex gap-3 items-center justify-start w-full hover:bg-[rgb(30,144,255)] transition-all duration-150 ease-in cursor-pointer px-2 py-2 rounded-sm">
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-template h-6">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 4m0 1a1 1 0 0 1 1 -1h14a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-14a1 1 0 0 1 -1 -1z" />
                    <path d="M4 12m0 1a1 1 0 0 1 1 -1h4a1 1 0 0 1 1 1v6a1 1 0 0 1 -1 1h-4a1 1 0 0 1 -1 -1z" />
                    <path d="M14 12l6 0" />
                    <path d="M14 16l6 0" />
                    <path d="M14 20l6 0" />
                </svg>
    
                <h3 class="text-lg text-white">Templates</h3>
            </div>
    
            <h3 class="text-lg text-white py-3">Reporting</h3>
    
            <div id="items-slide" data-uri="/projects" class="flex gap-3 items-center justify-start w-full hover:bg-[rgb(30,144,255)] transition-all duration-150 ease-in cursor-pointer px-2 py-2 rounded-sm">
                <svg  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-timeline h-6">
                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                    <path d="M4 16l6 -7l5 5l5 -6" />
                    <path d="M15 14m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                    <path d="M10 9m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                    <path d="M4 16m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                    <path d="M20 8m-1 0a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" />
                </svg>
    
                <h3 class="text-lg text-white">Metrics</h3>
            </div>
        </article>
    
        <hr class="border-slate-500">
    
        <!-- <Favorites client:only="react"/> -->
    
    </section>
    
    <footer class="flex flex-col justify-center">
        <hr class="border-slate-500">
        <div id="reward-btn" class="flex items-center justify-start gap-5 px-7 py-3 cursor-pointer transition-all hover:bg-[#1E90FF]">
            <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-gift"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M3 8m0 1a1 1 0 0 1 1 -1h16a1 1 0 0 1 1 1v2a1 1 0 0 1 -1 1h-16a1 1 0 0 1 -1 -1z" /><path d="M12 8l0 13" /><path d="M19 12v7a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-7" /><path d="M7.5 8a2.5 2.5 0 0 1 0 -5a4.8 8 0 0 1 4.5 5a4.8 8 0 0 1 4.5 -5a2.5 2.5 0 0 1 0 5" /></svg>
            <button class="font-2 text-lg text-white">Rewards</button>
        </div>
    
    </footer>
</div>

<style>
    @media (max-width: 768px){
        #slideMobile{
            height: calc(100% - 4rem);
        }
    }
</style>