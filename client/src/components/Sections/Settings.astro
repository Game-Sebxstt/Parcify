---
import Profile from "../Sections/Profile.astro"
import Appareance from "./Appareance.astro"
import Security from "./Security.astro"

interface Props {
    username: string;
    email: string;
    biography: string;
}

const {username, email, biography} = Astro.props;
---

<section id="content-configurations"class="bg-black/50 fixed h-full w-full z-50 justify-end hidden">
    <div class="bg-[#302f31] shadow-lg shadow-gray-900 w-full flex flex-col animate-displace py-4">
        <section class="w-full h-full flex justify-center">
            <div class="w-[20%] max-lg:w-[30%] max-sm:w-fit max-sm:px-2 h-full flex flex-col py-5 px-4 gap-4">
                <!-- Options panel -->
                <div class="flex w-full gap-5 h-fit max-sm:w-fit max-sm:gap-0">
                    <!-- Image and user -->
                    <div class="w-fit h-fit">
                        <div id="image-container" class="flex text-center align-middle items-center rounded-full w-12 h-12  max-sm:w-10">
                        </div>
                    </div>
                    <div class="w-full flex justify-between overflow-hidden text-ellipsis whitespace-nowrap">
                        <span class="w-full">
                            <h1 class="text-white text-xl max-xl:text-base max-sm:hidden">{username}</h1>
                            <p class="text-[#a7a5a5] text-xs max-xl:text-base max-sm:hidden truncate w-full">{biography}</p>
                        </span>
                       <span>
                  </div>
                </div>
                <div class="my-4 w-full h-full z-50">
                    <div>
                        <h1 class="text-xl max-sm:hidden max-sm:px-2">Settings</h1>
                    </div>

                    <!-- Configuration options -->
                    <div class="flex flex-col items-start py-3 w-full h-full max-sm:items-center">
                        <div id="profile-option" class="flex py-3 px-2 w-full my-2 gap-4 cursor-pointer hover:bg-slate-600 text-white text-xl max-sm:w-fit">
                            <span class="max-sm:px-2">
                                <svg  xmlns="http://www.w3.org/2000/svg"  width="24"  height="24"  viewBox="0 0 24 24"  fill="none"  stroke="white"  
                                stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round"  class="icon icon-tabler icons-tabler-outline icon-tabler-user">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
                                    <path d="M6 21v-2a4 4 0 0 1 4 -4h4a4 4 0 0 1 4 4v2" />
                                </svg>
                            </span>
                            <h1 class="text-white text-xl max-xl:text-base max-sm:hidden">Profile</h1>
                      </div>

                      <div id="security-option" class="flex py-3 px-2 w-full my-2 gap-4 cursor-pointer hover:bg-slate-600 text-white text-xl max-sm:w-fit">
                            <span class="max-sm:px-2">
                                <svg class="icon icon-tabler icons-tabler-filled icon-tabler-shield-lock" xmlns="http://www.w3.org/2000/svg" 
                                width="24"  height="24"  viewBox="0 0 24 24"  fill="none" stroke="white" stroke-width="2" stroke-lstroke-linecap="round"  stroke-linejoin="round">
                                    <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                                    <path d="M11.998 2l.118 .007l.059 .008l.061 .013l.111 .034a.993 .993 0 0 1 .217 .112l.104 .082l.255 .218a11 11 0 0 0 7.189 2.537l.342 -.01a1 1 0 0 1 1.005 .717a13 13 0 0 1 -9.208 16.25a1 1 0 0 1 -.502 0a13 13 0 0 1 -9.209 -16.25a1 1 0 0 1 1.005 -.717a11 11 0 0 0 7.531 -2.527l.263 -.225l.096 -.075a.993 .993 0 0 1 .217 -.112l.112 -.034a.97 .97 0 0 1 .119 -.021l.115 -.007zm.002 7a2 2 0 0 0 -1.995 1.85l-.005 .15l.005 .15a2 2 0 0 0 .995 1.581v1.769l.007 .117a1 1 0 0 0 1.993 -.117l.001 -1.768a2 2 0 0 0 -1.001 -3.732z" />
                                </svg>
                            </span>
                            <h1 class="text-white text-xl max-xl:text-base max-sm:hidden">Security</h1>
                      </div>
                    </div>
                </div>       
            </div>

            <div class="w-full pr-8">
              <div class="px-8 w-full h-full bg-black/50 pb-8 pt-8 flex overflow-y-auto flex-col max-sm:w-full rounded-xl gap-5 max-sm:px-5 relative">
                <button id="close_configurations" type="button" class="absolute top-2 right-2 text-gray-400 hover:bg-gray-200 hover:text-gray-900 rounded-lg w-8 h-8 inline-flex justify-center items-center">
                    <svg class="w-3 h-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 14" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 1 6 6m0 0 6 6M7 7l6-6M7 7l-6 6"/>
                    </svg>
                </button>

                <div id="profile-content" class="w-full h-full flex flex-col max-sm:w-full rounded-xl gap-5">
                    <Profile username = {username}, email = {email} biography={biography}></Profile>
                </div>
                <div id="security-content" class="w-full h-full flex flex-col max-sm:w-full rounded-xl gap-5" style="display:none">
                    <Security></Security>
                </div>
            
              </div>
            </div>
        </section>
    </div>
</section>