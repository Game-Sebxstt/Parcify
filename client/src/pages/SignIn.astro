                    ></g><g></g><g></g><g></g><g></g><g></g><g></g></svg
                  >
                </span>
                Google
              </button>

              <button
                class="flex gap-2 justify-center items-center max-[490px]:text-sm text-white/70 font-bold w-full h-fit border-[1px] border-[#a5a5a5] py-2.5 rounded-xl transition-all duration-200 ease-in hover:bg-[#a5a5a5]"
              >
                <span>
                  <svg
                    class="h-7 max-[490px]:h-5"
                    height="100%"
                    style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;"
                    version="1.1"
                    viewBox="0 0 512 512"
                    width="100%"
