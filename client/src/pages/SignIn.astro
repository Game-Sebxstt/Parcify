                    ></svg
                  >
                </span>
                Facebook
              </button>
            </div>

            <div class="w-full flex justify-center items-center gap-1 my-3 max-sm:text-sm">
              <span class="text-white font-semibold">Don't have an account?</span>
              <a href="/SignUp" class="font-bold text-blue-500">Sign up</a>
            </div>
          </form>
        </div>
      </div>

      <div class="w-[45%] h-100% bg-[#1E90FF] shadow-lg shadow-black/50 rounded-2xl max-[820px]:hidden flex flex-col justify-center items-center px-5">
        <img src="/Business-plan-01.svg" class="h-[50%] max-[980px]:h-[35%]">
        <h3 class="text-white text-2xl text-center font-bold mt-5 max-w-[20rem] max-[980px]:text-xl">
            Gestiona tus parceladores fácilmente con Parcify
        </h3>
      </div>
    </div>
  </div>
