                class="flex gap-2 justify-center items-center max-[490px]:text-sm text-white/70 font-bold w-full h-fit border-[1px] border-[#a5a5a5] py-2.5 rounded-xl transition-all duration-200 ease-in hover:bg-[#a5a5a5]"
