---
import LayoutForm from "../layouts/LayoutForm.astro";

const logged = Astro.cookies.get("logged")?.value;

if(logged == 'true'){
  return Astro.redirect("/")
}
---

<LayoutForm title="Parcify - Sign In">
  <div class="w-screen h-fit flex justify-center items-center max-xl:px-4 py-3">
    <div class="bg-gray-800 shadow-lg shadow-[#181818] w-full h-fit px-3 py-3 max-w-screen-xl rounded-3xl flex justify-between">
      <div class="w-[55%] max-[820px]:w-full h-full [980px]:px-10 flex justify-center items-center">
        <div class="w-full max-w-[80%] flex flex-col justify-center items-start gap-8"
        >
          <div class="flex justify-start items-center mt-5">
            <img src="/Logo-no-background-no-text.png" class="h-12" alt="" />
            <span class="text-white font-bold text-lg"> PARCIFY </span>
          </div>

          <div class="flex flex-col gap-1 justify-center items-start">
            <h2 class="text-white text-3xl font-bold max-md:text-xl">
              Log in to your account
            </h2>

            <h3 class="text-[#979797] text-base font-semibold max-md:text-sm">
              Welcome to Parcify Parcellers application
            </h3>
          </div>

          <form id="form_login" class="w-full flex flex-col gap-3">
            <div
              class="relative w-full h-full flex justify-start items-center mb-5"
            >
              <svg
                class="icon icon-tabler icons-tabler-outline icon-tabler-mail h-6 absolute left-2 text-gray-500"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z"
                ></path>
                <path d="M3 7l9 6l9 -6"></path>
              </svg>
              <input
                class="w-full py-3 pl-10 text-black font-semibold text-base outline-none bg-[#FFFF] rounded-[4px]"
                type="email"
                name="email_login"
                id="email_login"
                placeholder="Email"
                required
              />
            </div>

            <div class="relative w-full h-full flex justify-start items-center">
              <svg
                class="icon icon-tabler icons-tabler-outline icon-tabler-lock h-6 absolute left-2 text-gray-500"
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path
                  d="M5 13a2 2 0 0 1 2 -2h10a2 2 0 0 1 2 2v6a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-6z"
                ></path>
                <path d="M11 16a1 1 0 1 0 2 0a1 1 0 0 0 -2 0"></path>
                <path d="M8 11v-4a4 4 0 1 1 8 0v4"></path>
              </svg>
              <!-- EYE CLOSED SVG -->
              <svg  
                xmlns="http://www.w3.org/2000/svg"   
                viewBox="0 0 24 24"  
                fill="none"
                stroke="currentColor"  
                stroke-width="2"  
                stroke-linecap="round"  
                stroke-linejoin="round"  
                class="icon icon-tabler icons-tabler-outline icon-tabler-eye_off h-6 absolute right-2 text-black"
                id="eye_toggle_off"
                >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                <path d="M10.585 10.587a2 2 0 0 0 2.829 2.828" />
                <path d="M16.681 16.673a8.717 8.717 0 0 1 -4.681 1.327c-3.6 0 -6.6 -2 -9 -6c1.272 -2.12 2.712 -3.678 4.32 -4.674m2.86 -1.146a9.055 9.055 0 0 1 1.82 -.18c3.6 0 6.6 2 9 6c-.666 1.11 -1.379 2.067 -2.138 2.87" />
                <path d="M3 3l18 18" />
              </svg>
              <!-- EYE SVG -->
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-eye h-6 absolute right-2 text-black"
                id="eye_toggle"
              >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M10 12a2 2 0 1 0 4 0a2 2 0 0 0 -4 0"></path>
                <path   
                  d="M21 12c-2.4 4 -5.4 6 -9 6c-3.6 0 -6.6 -2 -9 -6c2.4 -4 5.4 -6 9 -6c3.6 0 6.6 2 9 6"
                ></path>
              </svg>
              <input
                class="w-full py-3 pl-10 text-black font-semibold text-base outline-none bg-[#FFFF] rounded-[4px]"
                type="password"
                name="password_login"
                id="password_login"
                placeholder="Password"
                required
              />
            </div>

            <div
              class="w-full flex justify-end text-blue-500 font-semibold my-2 max-sm:text-sm"
            >
              <span class="cursor-pointer"> Forgot password? </span>
            </div>

            <div class="w-full flex justify-center items-center">
              <button
                type="submit"
                class="bg-[#1E90FF] w-full py-3 text-sm text-white font-semibold rounded-[4px] hover:bg-[#1E90FF]/80 active:bg-[#1E90FF]/60"
              >
                Login
              </button>
            </div>

            <div class="w-full flex justify-center items-center my-2">
              <span class="flex uppercase text-white font-semibold text-sm">
                Or continue with
              </span>
            </div>

            <div class="flex gap-10 max-[490px]:gap-5 mb-3">
