<script>
  // password visualization SignIn

    //call elements by id 
    const password_login = document.getElementById('password_login') as HTMLInputElement
    const eye_toggle = document.getElementById('eye_toggle') as HTMLElement
    const eye_toggle_off = document.getElementById('eye_toggle_off') as HTMLElement
  
    eye_toggle_off.classList.add('hidden'); //hide second svg

    function showpass(){
      const type = password_login.getAttribute('type') === 'password' ? 'text' : 'password';

        password_login.setAttribute('type', type);
        eye_toggle_off.classList.contains('hidden') ? eye_toggle_off.classList.remove('hidden') : eye_toggle_off.classList.add('hidden'); 
    }

    eye_toggle.addEventListener("click", () => showpass());
</script>

