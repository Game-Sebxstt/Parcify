---
import Filter from '../components/Articles/Filter.astro';
import SearchBar from '../components/Articles/SearchBar.astro';
import Analytics from '../components/Popups/Analytics.astro';
import Content from '../components/Sections/Content.astro';
import ProjectsMetrics from '../components/React/components/ProjectsMetrics.jsx';
import Slide from '../components/Sections/SlideDesktop.astro';
import SlideMobile from '../components/Sections/SlideMobile.astro';
import Layout from '../layouts/Layout.astro';
import * as config from '../config'

const logged = Astro.cookies.get("logged")?.value;
const id = Astro.cookies.get("ID-USER")?.value;

if(logged != 'true' && !id){
  return Astro.redirect("/SignIn")
}

let get_data: any;
let data: any;

try{
	get_data = await fetch(`${config.getApiUrl()}/user/data?id_user=${id}`);
	data = await get_data.json();
	data = data.message;

	if(data == "El Usuario no existe."){
		Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
		Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
		return Astro.redirect("/SignIn")
	}
}catch(e){
	Astro.cookies.set("ID-USER", "false", {expires: new Date("9999-12-31")});
    Astro.cookies.set("logged", "false", {expires: new Date("9999-12-31")});
	return Astro.redirect("/SignIn")
}

---

<Layout title="Parcify">
	<div class="w-full h-fit flex">
		<Slide/>
		<SlideMobile/>
		<Analytics id_content='analytics'/>
		<Content>
			<article class="w-full">
				<div class="w-full flex max-[880px]:grid max-[880px]:grid-cols-1 max-[880px]:gap-3 justify-between items-center p-2 bg-[#383838] rounded-md shadow-lg shadow-[#181818] mb-4">
					<ul class="grid_filter flex gap-2 max-md:text-sm pr-2 place-items-center">
						<li class="relative w-full h-fit py-1 px-2 cursor-pointer flex justify-center items-center text-center">
							<svg  class="icon icon-tabler icons-tabler-outline icon-tabler-search h-6 absolute left-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"  fill="none"  stroke="white"  stroke-width="2"  stroke-linecap="round"  stroke-linejoin="round">
								<path stroke="none" d="M0 0h24v24H0z" fill="none"/>
								<path d="M10 10m-7 0a7 7 0 1 0 14 0a7 7 0 1 0 -14 0" />
								<path d="M21 21l-6 -6" />
							</svg>
							<SearchBar placeholder='Search Projects' article='project' section='projects'></SearchBar>
						</li>
					</ul>

					<div class="flex w-full h-fit items-center justify-between max-[880px]:pl-3">
						<Filter section='projects' article='project'/>
					</div>
				</div>

				<article class="w-full">
					<ProjectsMetrics client:only="react"/>
				</article>
		</Content>
	</div>
</Layout>


