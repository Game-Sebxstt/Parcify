---
import '../styles/app.css';

// viewportFit 'cover': sin él, env(safe-area-inset-*) vale 0 en iOS.
type Props = { title: string; description?: string; noindex?: boolean; viewportFit?: 'cover' };

const { title, description, noindex = false, viewportFit } = Astro.props;
const viewport = viewportFit ? `width=device-width, initial-scale=1, viewport-fit=${viewportFit}` : 'width=device-width, initial-scale=1';
---

<meta charset="utf-8" />
<meta name="viewport" content={viewport} />
<meta name="color-scheme" content="dark" />
<meta name="theme-color" content="#000b1d" />
<title>{title}</title>
{description && <meta name="description" content={description} />}
{noindex && <meta name="robots" content="noindex" />}
<link rel="icon" type="image/png" href="/brand/Logo-no-background-no-text.png" />
<script>
  import { initSentry } from '../lib/sentry.ts';

  void initSentry();
</script>
