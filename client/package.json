{
  "name": "parcify-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run shared:check && astro build",
    "preview": "astro preview",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --silent",
    "check": "npm run i18n && astro check && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "eslint .",
    "test": "npm run i18n && vitest run",
    "e2e": "playwright test --project=chromium --project=firefox --project=mobile --project=tablet",
    "shared:sync": "node scripts/shared-sync.ts",
    "shared:check": "node scripts/shared-check.ts",
    "contrast": "node scripts/contrast.ts",
    "budget": "node scripts/js-budget.ts",
    "bench": "playwright test -c bench/playwright.config.ts",
    "bench:ci": "playwright test -c bench/playwright.ci.config.ts"
  },
  "overrides": {
    "yjs": "13.6.33"
  },
  "dependencies": {
    "@ai-sdk/svelte": "5.0.141",
    "@astrojs/svelte": "9.1.0",
    "@floating-ui/dom": "1.8.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@hocuspocus/provider": "4.7.1",
    "@inlang/paraglide-js": "2.28.0",
    "@lucide/svelte": "1.57.0",
    "@sentry/browser": "11.8.0",
    "@tailwindcss/vite": "4.3.3",
    "ai": "7.0.141",
    "astro": "7.4.0",
    "better-auth": "1.7.10",
    "bits-ui": "2.19.5",
    "dompurify": "3.4.17",
    "fractional-indexing": "4.0.0",
    "lib0": "0.2.119",
    "marked": "18.1.1",
    "nanoid": "6.0.2",
    "pdf-lib": "1.17.1",
    "pixi.js": "8.22.0",
    "rbush": "4.0.1",
    "svelte": "5.57.2",
    "tailwindcss": "4.3.3",
    "y-indexeddb": "9.0.12",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@inlang/plugin-message-format": "4.5.4",
    "@playwright/test": "1.64.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@testing-library/svelte": "5.4.2",
    "@types/node": "26.6.5",
    "@types/rbush": "4.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-svelte": "3.23.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
