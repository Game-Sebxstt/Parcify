# Copia este archivo a .env. Astro incrusta estas variables al compilar: cambiarlas exige reconstruir.
# Cliente, API y colaboración deben compartir dominio registrable (p. ej. parcify.app y api.parcify.app).
PUBLIC_API_ORIGIN=http://localhost:3000
PUBLIC_COLLAB_ORIGIN=http://localhost:3001
PUBLIC_SITE_ORIGIN=http://localhost:4321
# Origen de las URLs firmadas de imágenes: el bucket S3 o la propia API con STORAGE_DRIVER=local.
PUBLIC_STORAGE_ORIGIN=http://localhost:3000
# Opcional.
PUBLIC_SENTRY_DSN=
# Solo en builds de pruebas e2e.
PUBLIC_TEST_HOOKS=
# Ruta del servidor para shared:sync y shared:check (por defecto ../server, la carpeta hermana del monorepo).
PARCIFY_SERVER_DIR=
# 1 para incluir la página /_bench en el build.
PARCIFY_BENCH=
